--- /dev/null
+++ b/tests/test_bench.c
@@ -0,0 +1,245 @@
+#include <assert.h>
+#include <limits.h>
+#include <stdio.h>
+#include "app.h"
+
+/* Exercise the production App/ADC functions. These samples are test inputs,
+ * not a model of converter dynamics or evidence of real hardware limits. */
+static const Sample healthy = {15000, 50, 2000, 200, 200, 14500, 1};
+
+static void outputs_off(const App *a)
+{
+    assert(a->enable == 0);
+    assert(a->arm == 0);
+    assert(a->duty == 0);
+}
+
+static void tick(App *a, const Sample *s, unsigned count, u8 fault_n, u8 oc_n)
+{
+    while (count--) app_tick(a, s, fault_n, oc_n);
+}
+
+static void enter_ready(App *a)
+{
+    app_init(a);
+    app_command(a, CMD_START, 0);
+    app_command(a, CMD_CONFIRM_BYPASS, 0);
+    assert(a->state == OFF && !a->bypass_confirmed);
+    outputs_off(a);
+
+    app_command(a, CMD_PRECHARGE, 0);
+    assert(a->state == PRECHARGE);
+    app_command(a, CMD_START, 0);
+    app_command(a, CMD_CONFIRM_BYPASS, 0);
+    assert(a->state == PRECHARGE && !a->bypass_confirmed);
+    tick(a, &healthy, PRECHARGE_MS - 1, 1, 1);
+    assert(a->state == PRECHARGE);
+    outputs_off(a);
+    tick(a, &healthy, 1, 1, 1);
+    assert(a->state == READY);
+    outputs_off(a);
+
+    app_command(a, CMD_START, 0);
+    assert(a->state == READY && !a->bypass_confirmed);
+    outputs_off(a);
+}
+
+static void manual_start(App *a)
+{
+    assert(a->state == READY);
+    app_command(a, CMD_CONFIRM_BYPASS, 0);
+    assert(a->bypass_confirmed);
+    app_command(a, CMD_START, 0);
+    assert(a->state == ARMING && !a->enable && !a->arm);
+
+    tick(a, &healthy, 1, 1, 1);
+    assert(a->state == ARMING && a->arm && !a->enable);
+    assert(a->duty == 0);
+    tick(a, &healthy, 1, 1, 1);
+    assert(a->state == SOFTSTART && !a->arm && a->enable);
+    tick(a, &healthy, SOFTSTART_MS - 1, 1, 1);
+    assert(a->state == SOFTSTART);
+    tick(a, &healthy, 1, 1, 1);
+    assert(a->state == RUN && a->enable && !a->arm);
+}
+
+static void enter_run(App *a)
+{
+    enter_ready(a);
+    manual_start(a);
+}
+
+static void test_boot_and_limits(void)
+{
+    App a;
+    assert(POWER_STAGE_ALLOWED == 1);
+    assert(DUTY_MAX == 2500);
+    app_init(&a);
+    assert(a.state == OFF && a.fault == F_NONE);
+    assert(a.vset == 2000 && a.iset == 200);
+    outputs_off(&a);
+
+    app_command(&a, CMD_SET_V, INT_MAX);
+    app_command(&a, CMD_SET_I, INT_MAX);
+    assert(a.vset == 2000 && a.iset == 200);
+    app_command(&a, CMD_SET_V, INT_MIN);
+    app_command(&a, CMD_SET_I, INT_MIN);
+    assert(a.vset == 200 && a.iset == 100);
+    app_command(&a, CMD_SET_V, 1500);
+    app_command(&a, CMD_SET_I, 150);
+    assert(a.vset == 1500 && a.iset == 150);
+    outputs_off(&a);
+
+    enter_run(&a);
+    app_command(&a, CMD_SET_V, 1500);
+    app_command(&a, CMD_SET_I, 100);
+    assert(a.vset == 2000 && a.iset == 200);
+    app_command(&a, CMD_STOP, 0);
+    assert(a.state == OFF && !a.bypass_confirmed);
+    assert(a.vset == 2000 && a.iset == 200);
+    outputs_off(&a);
+    tick(&a, &healthy, 1000, 1, 1);
+    assert(a.state == OFF);
+    outputs_off(&a);
+}
+
+static void test_hard_fault_manual_recovery(void)
+{
+    App a;
+    enter_run(&a);
+    tick(&a, &healthy, 1, 0, 1);
+    assert(a.state == TRIPPED && a.fault == F_HARDWARE);
+    assert(!a.bypass_confirmed);
+    outputs_off(&a);
+
+    tick(&a, &healthy, 1000, 1, 1);
+    app_command(&a, CMD_START, 0);
+    app_command(&a, CMD_CONFIRM_BYPASS, 0);
+    assert(a.state == TRIPPED && !a.bypass_confirmed);
+    outputs_off(&a);
+
+    app_command(&a, CMD_SET_V, INT_MAX);
+    app_command(&a, CMD_SET_I, INT_MAX);
+    assert(a.vset == 2000 && a.iset == 200);
+    app_command(&a, CMD_PRECHARGE, 0);
+    tick(&a, &healthy, PRECHARGE_MS, 1, 1);
+    assert(a.state == READY && !a.bypass_confirmed);
+    app_command(&a, CMD_START, 0);
+    assert(a.state == READY);
+    outputs_off(&a);
+    manual_start(&a);
+}
+
+static void test_duty_cap_and_stop(void)
+{
+    App a;
+    Sample s = healthy;
+    int reached_cap = 0;
+    enter_run(&a);
+    for (unsigned n = 0; n < 5000; n++) {
+        /* Positive CV/CC errors demand more duty, including saturation. */
+        s.vout = 600 + (i32)(n % 1200);
+        s.iout = (i32)(n % 90);
+        app_tick(&a, &s, 1, 1);
+        assert(a.state == RUN && a.enable && !a.arm);
+        assert(a.duty >= 0 && a.duty <= 2500);
+        if (a.duty == 2500) reached_cap = 1;
+    }
+    assert(reached_cap);
+    app_command(&a, CMD_STOP, 0);
+    assert(a.state == OFF && !a.bypass_confirmed);
+    outputs_off(&a);
+}
+
+static void test_retained_fault_boundaries(void)
+{
+    App a;
+    Sample s = healthy;
+    enter_run(&a);
+    tick(&a, &healthy, OC_DELAY_MS - 1, 1, 0);
+    assert(a.state == RUN);
+    tick(&a, &healthy, 1, 1, 0);
+    assert(a.state == TRIPPED && a.fault == F_OC);
+    outputs_off(&a);
+
+    enter_run(&a);
+    s.vout = 100;
+    tick(&a, &s, UV_DELAY_MS - 1, 1, 1);
+    assert(a.state == RUN);
+    tick(&a, &s, 1, 1, 1);
+    assert(a.state == TRIPPED && a.fault == F_LOW_OUTPUT);
+    outputs_off(&a);
+
+    enter_run(&a);
+    s = healthy;
+    s.valid = 0;
+    tick(&a, &s, 1, 1, 1);
+    assert(a.state == TRIPPED && a.fault == F_ADC);
+    outputs_off(&a);
+
+    enter_run(&a);
+    s = healthy;
+    s.vin_post = 10000;
+    tick(&a, &s, 1, 1, 1);
+    assert(a.state == TRIPPED && a.fault == F_INPUT);
+    outputs_off(&a);
+}
+
+static void test_adc_units_and_invalid_rails(void)
+{
+    const u16 raw[6] = {1692, 124, 226, 248, 2048, 1636};
+    u16 invalid[6] = {1692, 124, 226, 248, 2048, 1636};
+    Sample s;
+    adc_convert(raw, &s);
+    assert(s.valid);
+    assert(s.vin >= 14990 && s.vin <= 15010);
+    assert(s.iin >= 98 && s.iin <= 101);
+    assert(s.vout >= 1995 && s.vout <= 2010);
+    assert(s.iout >= 198 && s.iout <= 202);
+    assert(s.il >= -2 && s.il <= 2);
+    assert(s.vin_post >= 14490 && s.vin_post <= 14510);
+
+    invalid[0] = 4095;
+    adc_convert(invalid, &s);
+    assert(!s.valid);
+    invalid[0] = raw[0];
+    invalid[4] = 0;
+    adc_convert(invalid, &s);
+    assert(!s.valid);
+}
+
+static void test_bench_voltage_boundaries(void)
+{
+    App a;
+    Sample s = healthy;
+    enter_run(&a);
+    s.vout = 3000;
+    tick(&a, &s, 1, 1, 1);
+    assert(a.state == RUN);
+    s.vout = 3001;
+    tick(&a, &s, 1, 1, 1);
+    assert(a.state == TRIPPED && a.fault == F_OV);
+    outputs_off(&a);
+
+    enter_run(&a);
+    s = healthy;
+    s.vin = 16000;
+    tick(&a, &s, 1, 1, 1);
+    assert(a.state == RUN);
+    s.vin = 16001;
+    tick(&a, &s, 1, 1, 1);
+    assert(a.state == TRIPPED && a.fault == F_INPUT);
+    outputs_off(&a);
+}
+
+int main(void)
+{
+    test_boot_and_limits();
+    test_hard_fault_manual_recovery();
+    test_duty_cap_and_stop();
+    test_retained_fault_boundaries();
+    test_adc_units_and_invalid_rails();
+    test_bench_voltage_boundaries();
+    puts("PASS B1: 2V/200mA command caps, 25% duty cap, manual interlocks/ARM/recovery, OC/UV/input/ADC faults, STOP and ADC units");
+    return 0;
+}
