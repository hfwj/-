--- /dev/null
+++ b/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/src/diag.c
@@ -0,0 +1,89 @@
+#include "diag.h"
+#include <stdint.h>
+_Static_assert(sizeof(u32)==4,"SWD requires 32-bit words");
+_Static_assert(sizeof(DebugWindow)==256,"SWD window is 256 bytes");
+_Static_assert(sizeof(TraceRecord)==40,"Trace ABI is ten words");
+_Static_assert(D_END==63,"SWD ABI must end at word 63");
+__attribute__((section(".swd_mailbox"),used,aligned(4)))
+volatile DebugWindow debug_window;
+__attribute__((section(".swd_trace"),used,aligned(4)))
+volatile TraceRecord debug_trace[TRACE_CAPACITY];
+volatile u32 debug_adc_raw[6];
+static u32 trace_count,trace_next,trace_frozen,last_state,last_en,last_arm;
+static HwSnapshot first_hw;
+static u32 hw_saved;
+static u32 platform_ready;
+void diag_reset_trace(void){
+ trace_count=trace_next=trace_frozen=hw_saved=0;
+ last_state=last_en=last_arm=0xFFFFFFFFu;
+}
+void diag_init(void){
+ platform_ready=0;
+ for(u32 i=0;i<64;i++)debug_window.w[i]=0;
+ for(u32 i=0;i<TRACE_CAPACITY;i++)for(u32 j=0;j<TRACE_WORDS;j++)debug_trace[i].w[j]=0;
+ for(u32 i=0;i<6;i++)debug_adc_raw[i]=0;
+ diag_reset_trace();
+ debug_window.w[D_MAGIC]=0x42324332u;
+ debug_window.w[D_ABI]=0x00020001u;
+ debug_window.w[D_WORDS]=64;
+ debug_window.w[D_TRACE_BASE]=(u32)(uintptr_t)debug_trace;
+ debug_window.w[D_TRACE_CAP]=TRACE_CAPACITY;
+ debug_window.w[D_TRACE_WORDS]=TRACE_WORDS;
+ debug_window.w[D_RAW_BASE]=(u32)(uintptr_t)debug_adc_raw;
+ debug_window.w[D_END]=0x454E4432u;
+}
+void diag_set_ready(void){platform_ready=1;}
+void diag_ack(Command cmd,CmdResult result){
+ debug_window.w[D_SEQ]++;
+ debug_window.w[D_LAST_CMD]=(u32)cmd;
+ debug_window.w[D_LAST_CMD_SEQ]=++debug_window.w[D_ACK_SEQ];
+ debug_window.w[D_ACK]=(u32)result;
+ debug_window.w[D_SEQ]++;
+}
+void diag_update(const App *a,const Sample *s,const HwSnapshot *before,
+                 u32 current_idr,u32 scans,u32 failures,u32 irq_count,u32 cycles){
+ debug_window.w[D_SEQ]++;
+ if(a->last_fault.valid && !hw_saved){first_hw=*before;hw_saved=1;}
+ if(!trace_frozen && (a->tick_ms%5==0 || (u32)a->state!=last_state ||
+     a->enable!=last_en || a->arm!=last_arm || a->last_fault.valid)){
+  volatile TraceRecord *t=&debug_trace[trace_next];
+  t->w[0]=a->tick_ms;
+  t->w[1]=(u32)a->state|((u32)a->fault<<8)|((u32)a->enable<<16)|((u32)a->arm<<17);
+  t->w[2]=(u32)s->vin;t->w[3]=(u32)s->vin_post;t->w[4]=(u32)s->vout;
+  t->w[5]=(u32)s->iout;t->w[6]=(u32)s->il;
+  t->w[7]=(u32)(a->last_fault.valid?a->last_fault.duty:a->duty);
+  t->w[8]=before->idr;
+  t->w[9]=(before->ccr&0xFFFFu)|((before->bdtr&(1u<<15))<<1)|
+          ((before->cr1&1u)<<17)|((before->ccer&1u)<<18);
+  trace_next=(trace_next+1)%TRACE_CAPACITY;
+  if(trace_count<TRACE_CAPACITY)trace_count++;
+ }
+ last_state=(u32)a->state;last_en=a->enable;last_arm=a->arm;
+ if(a->last_fault.valid)trace_frozen=1;
+ volatile u32 *d=debug_window.w;
+ d[D_FLAGS]=(POWER_STAGE_ALLOWED?1u:0u)|(trace_frozen<<1)|(platform_ready<<2);
+ d[D_STATE]=a->state;d[D_FAULT]=a->fault;d[D_VSET]=(u32)a->vset;d[D_ISET]=(u32)a->iset;
+ d[D_VIN]=(u32)s->vin;d[D_IIN]=(u32)s->iin;d[D_VOUT]=(u32)s->vout;
+ d[D_IOUT]=(u32)s->iout;d[D_IL]=(u32)s->il;d[D_POST]=(u32)s->vin_post;
+ d[D_DUTY]=(u32)a->duty;d[D_EN]=a->enable;d[D_ARM]=a->arm;d[D_TICKS]=a->tick_ms;
+ d[D_SCANS]=scans;d[D_ADC_FAILURES]=failures;
+ const FaultRecord *f=&a->last_fault;
+ d[D_RECORD]=f->valid;d[D_RECORD_CODE]=f->code;d[D_RECORD_STATE]=f->state_before;
+ d[D_RECORD_TICK]=f->tick_ms;d[D_RECORD_VOUT]=(u32)f->vout;d[D_RECORD_IOUT]=(u32)f->iout;
+ d[D_RECORD_IL]=(u32)f->il;d[D_RECORD_VIN]=(u32)f->vin;d[D_RECORD_POST]=(u32)f->vin_post;
+ d[D_RECORD_DUTY]=(u32)f->duty;d[D_RECORD_CV]=(u32)f->cv_out;d[D_RECORD_CC]=(u32)f->cc_out;
+ d[D_RECORD_FLAGS]=f->flags;
+ const HwSnapshot *h=hw_saved?&first_hw:before;
+ d[D_HW_IDR]=h->idr;d[D_HW_CCR]=h->ccr;d[D_HW_BDTR]=h->bdtr;
+ d[D_HW_CR1]=h->cr1;d[D_HW_CCER]=h->ccer;d[D_HW_CRL]=h->crl;d[D_AFTER_KILL]=h->after_kill;
+ d[D_RESERVED_OLD_CMD]=0; /* A1/B1 0x2000009C can never start B2. */
+ d[D_TRACE_COUNT]=trace_count;d[D_TRACE_NEXT]=trace_next;d[D_TRACE_FROZEN]=trace_frozen;
+ if(current_idr&2u)d[D_ARM_SEEN]++;
+ if(current_idr&1u)d[D_EN_SEEN]++;
+ d[D_IRQ_COUNT]=irq_count;
+ if(cycles>d[D_ISR_CYCLES])d[D_ISR_CYCLES]=cycles;
+ d[D_MAX_VOUT]=(u32)(f->valid?f->max_vout:a->max_vout);
+ d[D_STARTUP_MS]=f->valid?f->startup_ms:a->startup_ms;
+ d[D_CURRENT_IDR]=current_idr;d[D_TARGET]=(u32)(f->valid?f->target_mv:a->target_mv);
+ debug_window.w[D_SEQ]++;
+}
diff --git a/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/src/lcd.c b/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/src/lcd.c
