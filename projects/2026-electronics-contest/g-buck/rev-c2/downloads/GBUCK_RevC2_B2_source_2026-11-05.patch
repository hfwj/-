--- /dev/null
+++ b/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/tests/test_platform.c
@@ -0,0 +1,244 @@
+/* Integration regression for the real SysTick/mailbox adapter. This narrow
+ * host register/IRQ model does not establish physical pin or timing behavior. */
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "app.h"
+
+#if !POWER_STAGE_ALLOWED
+#error "Platform adapter regression requires POWER_STAGE_ALLOWED=1"
+#endif
+
+static volatile u32 *mock_reg(u32 address);
+#define REG(a) (*mock_reg(a))
+#define HOST_TEST 1
+#define main firmware_main
+#include "../src/main.c"
+#undef main
+
+static u32 idr, ccr, bdtr, cr1, ccer, crl, exti_pr, cycles;
+static u32 other_register;
+static u32 irq_masked, inject_fault_on_unlock, output_calls, kill_calls;
+static u32 expect_rearm_lock;
+static const u16 healthy_raw[6] = {1692, 0, 0, 0, 2048, 1557};
+
+static volatile u32 *mock_reg(u32 address) {
+ switch (address) {
+ case GPIOB + 8: return &idr;
+ case GPIOB: return &crl;
+ case TIM1 + 0x34: return &ccr;
+ case TIM1 + 0x44: return &bdtr;
+ case TIM1: return &cr1;
+ case TIM1 + 0x20: return &ccer;
+ case 0x40010414u: return &exti_pr;
+ case 0xE0001004u: return &cycles;
+ default:
+  assert(0 && "unexpected host register access");
+  return &other_register;
+ }
+}
+
+void platform_test_lock(void) {
+ assert(!irq_masked);
+ if (expect_rearm_lock) {
+  /* PRECHARGE must not mutate the state/record before masking IRQs. */
+  assert(app.state == TRIPPED && app.last_fault.valid);
+  expect_rearm_lock = 0;
+ }
+ irq_masked = 1;
+}
+
+static void dispatch_fault_irq(void) {
+ assert(!irq_masked);
+ exti_pr |= 1u << 10;
+ EXTI15_10_IRQHandler();
+ /* The actual handler writes one to clear EXTI_PR10. A plain host lvalue
+  * cannot implement W1C, so apply that peripheral effect after dispatch. */
+ assert(exti_pr == (1u << 10));
+ exti_pr = 0;
+}
+
+void platform_test_unlock(void) {
+ assert(irq_masked);
+ irq_masked = 0;
+ if (inject_fault_on_unlock) {
+  inject_fault_on_unlock = 0;
+  dispatch_fault_irq(); /* A fresh pulse after the atomic manual rearm. */
+ }
+}
+
+u8 board_sample(u16 raw[6]) {
+ memcpy(raw, healthy_raw, sizeof(healthy_raw));
+ return 1;
+}
+void board_kill(void) {
+ kill_calls++;
+ idr &= ~3u;
+ bdtr &= ~(1u << 15);
+ ccr = 0;
+}
+void board_outputs(const App *a) {
+ assert(irq_masked);
+ output_calls++;
+ idr = (idr & ~3u) | (a->enable ? 1u : 0u) | (a->arm ? 2u : 0u);
+ ccr = a->enable ? (u32)a->duty * PWM_PERIOD / 10000u : 0;
+ bdtr = a->enable ? bdtr | (1u << 15) : bdtr & ~(1u << 15);
+}
+void board_init(void) {}
+void lcd_init(void) {}
+void lcd_update(const App *a, const Sample *s) { (void)a; (void)s; }
+
+static void reset_fixture(void) {
+ app_init(&app);
+ diag_init();
+ sample = (Sample){0};
+ ticks = hard_fault = fault_irq_count = scans = failures = 0;
+ platform_ready = 1;
+ idr = (1u << 10) | (1u << 11);
+ ccr = bdtr = exti_pr = other_register = 0;
+ cr1 = 0x81; ccer = 1; crl = 0x44444422;
+ /* Keep DWT constant: these tests exercise dispatch, not elapsed-time checks.
+  * SysTick's function-local previous counter therefore stays consistent. */
+ cycles = 1000;
+ irq_masked = inject_fault_on_unlock = output_calls = kill_calls = 0;
+ expect_rearm_lock = 0;
+}
+
+static void command_tick(Command command) {
+ debug_window.w[D_VALUE] = 0;
+ debug_window.w[D_CMD] = (u32)command;
+ SysTick_Handler();
+ assert(!irq_masked);
+ assert(debug_window.w[D_CMD] == 0);
+ assert(debug_window.w[D_LAST_CMD] == (u32)command);
+ assert(output_calls == 1);
+}
+
+static void set_running(void) {
+ app.state = RUN;
+ app.enable = 1;
+ app.duty = 500;
+ app.target_mv = app.vset;
+ idr |= 1u;
+ ccr = 500u * PWM_PERIOD / 10000u;
+ bdtr = 1u << 15;
+}
+
+static void assert_off(void) {
+ assert(!app.enable && !app.arm && !app.duty);
+ assert(!(idr & 3u) && !ccr && !(bdtr & (1u << 15)));
+}
+
+static void test_not_ready(void) {
+ const Command commands[] = {CMD_PRECHARGE, CMD_CONFIRM_BYPASS, CMD_START};
+ for (u32 i = 0; i < sizeof(commands) / sizeof(commands[0]); i++) {
+  reset_fixture();
+  platform_ready = 0;
+  if (commands[i] != CMD_PRECHARGE) app.state = READY;
+  if (commands[i] == CMD_START) app.bypass_confirmed = 1;
+  command_tick(commands[i]);
+  assert(debug_window.w[D_ACK] == CMD_BAD_STATE);
+  assert(app.state == (commands[i] == CMD_PRECHARGE ? OFF : READY));
+  assert_off();
+ }
+}
+
+static void test_rejected_rearm_preserves_fault(void) {
+ reset_fixture();
+ set_running();
+ hard_fault = 1;
+ command_tick(CMD_PRECHARGE);
+ assert(debug_window.w[D_ACK] == CMD_BAD_STATE);
+ assert(hard_fault == 1 && app.state == TRIPPED && app.fault == F_HARDWARE);
+ assert(app.last_fault.state_before == RUN);
+ assert_off();
+}
+
+static void test_accepted_rearm(void) {
+ reset_fixture();
+ app_trip(&app, F_HARDWARE);
+ hard_fault = 1;
+ command_tick(CMD_PRECHARGE);
+ assert(debug_window.w[D_ACK] == CMD_OK);
+ assert(!hard_fault && app.state == PRECHARGE && app.fault == F_NONE);
+ assert(!app.last_fault.valid && app.pre_ms == 1);
+ assert_off();
+}
+
+static void test_pending_or_low_fault_preserved(void) {
+ for (u32 pending = 0; pending < 2; pending++) {
+  reset_fixture();
+  app_trip(&app, F_HARDWARE);
+  hard_fault = 1;
+  if (pending) exti_pr = 1u << 10;
+  else idr &= ~(1u << 10);
+  command_tick(CMD_PRECHARGE);
+  assert(debug_window.w[D_ACK] == CMD_OK);
+  assert(hard_fault == 1 && app.state == TRIPPED && app.fault == F_HARDWARE);
+  assert_off();
+ }
+ /* An undispatched pending edge also blocks outputs without a prior sticky. */
+ reset_fixture();
+ exti_pr = 1u << 10;
+ command_tick(CMD_PRECHARGE);
+ assert(app.state == TRIPPED && app.fault == F_HARDWARE);
+ assert_off();
+}
+
+static void test_fault_at_rearm_unlock(void) {
+ reset_fixture();
+ app_trip(&app, F_HARDWARE);
+ hard_fault = 1;
+ expect_rearm_lock = 1;
+ inject_fault_on_unlock = 1;
+ command_tick(CMD_PRECHARGE);
+ assert(debug_window.w[D_ACK] == CMD_OK);
+ assert(hard_fault == 1 && fault_irq_count == 1 && kill_calls == 1);
+ assert(!expect_rearm_lock);
+ assert(app.state == TRIPPED && app.fault == F_HARDWARE);
+ assert_off();
+}
+
+static void test_pad_readbacks(void) {
+ reset_fixture();
+ app.state = ARMING; app.arm = 1; /* Requested last tick, pad still low. */
+ SysTick_Handler();
+ assert(app.state == TRIPPED && app.fault == F_ARM_PIN);
+ assert(app.last_fault.code == F_ARM_PIN);
+ assert_off();
+
+ reset_fixture();
+ set_running();
+ idr &= ~1u;
+ SysTick_Handler();
+ assert(app.state == TRIPPED && app.fault == F_EN_PIN);
+ assert(app.last_fault.code == F_EN_PIN);
+ assert_off();
+}
+
+static void test_stop_and_inert_legacy_mailbox(void) {
+ reset_fixture();
+ set_running();
+ command_tick(CMD_STOP);
+ assert(debug_window.w[D_ACK] == CMD_OK && app.state == OFF);
+ assert_off();
+
+ reset_fixture();
+ debug_window.w[D_RESERVED_OLD_CMD] = CMD_START;
+ SysTick_Handler();
+ assert(app.state == OFF && debug_window.w[D_ACK_SEQ] == 0);
+ assert(debug_window.w[D_RESERVED_OLD_CMD] == 0);
+ assert_off();
+}
+
+int main(void) {
+ test_not_ready();
+ test_rejected_rearm_preserves_fault();
+ test_accepted_rearm();
+ test_pending_or_low_fault_preserved();
+ test_fault_at_rearm_unlock();
+ test_pad_readbacks();
+ test_stop_and_inert_legacy_mailbox();
+ puts("platform: real SysTick mailbox, readiness gate, atomic rearm, pending/new IRQ, pad readback and STOP pass (host model only)");
+ return 0;
+}
diff --git a/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/tests/verify_image.py b/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/tests/verify_image.py
new file mode 100644
--- /dev/null
+++ b/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/tests/verify_image.py
@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+"""Check actual ELF placement, vector entries, Intel HEX checksum and BIN match."""
+import hashlib
+from pathlib import Path
+import struct
+import sys
+
+build = Path(sys.argv[1] if len(sys.argv) > 1 else 'build/p1-l1')
+elf = (build / 'gbuck.elf').read_bytes()
+h = struct.unpack_from('<16sHHIIIIIHHHHHH', elf)
+assert h[0][:7] == b'\x7fELF\x01\x01\x01' and h[2] == 40
+sections = [struct.unpack_from('<IIIIIIIIII', elf, h[6] + i*h[11]) for i in range(h[12])]
+namesec = sections[h[13]]
+names = elf[namesec[4]:namesec[4]+namesec[5]]
+def name(offset):
+    return names[offset:names.index(0, offset)].decode()
+sections = {name(s[0]): s for s in sections}
+assert sections['.swd_mailbox'][3:6:2] == (0x20000000, 0x100)
+assert sections['.swd_trace'][3:6:2] == (0x20000100, 0x2800)
+assert sections['.data'][3] >= 0x20002900
+bss = sections['.bss']
+assert bss[3]+bss[5]+2048 < 0x20005000
+image = (build / 'gbuck.bin').read_bytes()
+assert 0 < len(image) <= 65536
+vectors = struct.unpack_from('<76I', image)
+assert vectors[0] == 0x20005000
+assert h[4] == vectors[1]
+for i in (1,2,3,4,5,6,11,12,14,15,56):
+    assert vectors[i] & 1 and 0x08000000 <= (vectors[i] & ~1) < 0x08000000+len(image)
+decoded = {}
+base = 0
+ended = False
+for line in (build / 'gbuck.hex').read_text().splitlines():
+    assert line.startswith(':') and not ended
+    data = bytes.fromhex(line[1:])
+    assert len(data) == data[0]+5 and sum(data)%256 == 0
+    address = int.from_bytes(data[1:3], 'big')
+    kind = data[3]
+    payload = data[4:-1]
+    if kind == 0:
+        for i, byte in enumerate(payload):
+            addr = base+address+i
+            assert 0x08000000 <= addr < 0x08010000 and addr not in decoded
+            decoded[addr] = byte
+    elif kind == 4:
+        assert len(payload) == 2
+        base = int.from_bytes(payload, 'big') << 16
+    elif kind == 1:
+        assert not payload
+        ended = True
+    else:
+        assert kind == 5  # optional start-linear address
+assert ended and len(decoded) == len(image)
+assert bytes(decoded[0x08000000+i] for i in range(len(image))) == image
+print(f'{build}: ELF ABI/vectors/RAM, HEX checksum/address and BIN equality PASS')
+print(f'flash={len(image)}B static_ram_end=0x{bss[3]+bss[5]:08X} '
+      f'stack_gap={0x20005000-bss[3]-bss[5]}B')
+for ext in ('bin','hex'):
+    p=build / f'gbuck.{ext}'
+    print(f'{p.name} sha256={hashlib.sha256(p.read_bytes()).hexdigest()}')
