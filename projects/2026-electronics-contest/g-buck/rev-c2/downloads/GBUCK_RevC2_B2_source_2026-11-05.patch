+#ifndef CONFIG_H
+#define CONFIG_H
+
+/* B2 is a bounded diagnostic prototype, never a higher-power build. */
+#ifndef POWER_STAGE_ALLOWED
+#define POWER_STAGE_ALLOWED 0
+#endif
+#ifndef KEYS_ENABLED
+#define KEYS_ENABLED 0
+#endif
+#ifndef LCD_ENABLED
+#define LCD_ENABLED 1
+#endif
+#if POWER_STAGE_ALLOWED != 0 && POWER_STAGE_ALLOWED != 1
+#error "POWER_STAGE_ALLOWED must be 0 or 1"
+#endif
+#define CPU_HZ 64000000u
+#define PWM_PERIOD 2133u
+#define ADC_VDDA_MV 3300
+#define LCD_WIDTH 128
+#define LCD_HEIGHT 160
+#define LCD_X_OFFSET 0
+#define LCD_Y_OFFSET 0
+#define LCD_MADCTL 0x00
+
+#define DEFAULT_VSET_MV 2000
+#define DEFAULT_ISET_MA 200
+#define VSET_MIN_MV 200
+#define VSET_MAX_MV 2000
+#define ISET_MIN_MA 100
+#define ISET_MAX_MA 200
+#define DUTY_MAX 2500 /* basis points, 25% absolute software ceiling */
+#define VIN_MIN_MV 12000
+#define VIN_MAX_MV 16000
+#define VIN_POST_MIN_MV 11000
+#define PRECHARGE_GAP_MAX_MV 1500
+#define PRECHARGE_MS 100u
+#define OUTPUT_OV_MV 3000
+#define PREBIAS_MAX_MV 100 /* also limited to Vset/4; discharge before START */
+
+#define ARM_MS 2u
+#define DRIVER_SETTLE_MS 2u
+#define STARTUP_RAMP_MS 300u
+#define STARTUP_SETTLE_MS 100u
+#define STARTUP_NO_RISE_MS 250u
+#define STARTUP_TIMEOUT_MS 1000u
+#define OC_DELAY_MS 20u
+#define UV_DELAY_MS 20u
+#define SOFTSTART_MS STARTUP_RAMP_MS
+#define STARTUP_V_TOLERANCE_MIN_MV 100
+#define STARTUP_V_TOLERANCE_PERCENT 5
+#define STARTUP_CC_TOLERANCE_PERCENT 10
+#define STARTUP_RISE_MAX_MV 100
+#define OUTPUT_FLOOR_MAX_MV 500
+
+/* A 1 kHz ADC guard; this cannot detect or replace peak-current protection. */
+#define SAMPLED_IOUT_TRIP_MA 400
+#define SAMPLED_IL_TRIP_MA 800
+#define SAMPLED_CURRENT_DELAY_MS 2u
+
+/* Error gains scale by 1000; integral advances once per 1 ms sample.
+ * Feedforward supplies nominal buck duty. CV only adds a bounded trim.
+ * These conservative starting values have not been tuned on hardware. */
+#define CV_KP 100
+#define CV_KI 2
+#define CV_TRIM_MAX_BP 600
+#define CC_KP 500
+#define CC_KI 10
+#define CC_RELEASE_MARGIN_MA 20
+#define DUTY_RISE_MAX_BP_PER_MS 20
+
+#endif
