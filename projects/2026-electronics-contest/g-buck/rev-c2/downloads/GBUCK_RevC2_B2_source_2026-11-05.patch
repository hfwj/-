+PREFIX ?= arm-none-eabi-
+CC = $(PREFIX)gcc
+OBJCOPY = $(PREFIX)objcopy
+SIZE = $(PREFIX)size
+POWER ?= 0
+LCD ?= 1
+BUILD = build/p$(POWER)-l$(LCD)
+CFLAGS = -mcpu=cortex-m3 -mthumb -std=c11 -Os -g3 -ffreestanding -fno-builtin -Wall -Wextra -Werror -ffunction-sections -fdata-sections -Iinclude -DPOWER_STAGE_ALLOWED=$(POWER) -DLCD_ENABLED=$(LCD)
+SRC = $(wildcard src/*.c)
+.PHONY: all test clean
+all: $(BUILD)/gbuck.bin $(BUILD)/gbuck.hex
+$(BUILD)/gbuck.elf: $(SRC) $(wildcard include/*.h) stm32f103c8.ld Makefile
+	mkdir -p $(BUILD)
+	$(CC) $(CFLAGS) $(SRC) -nostdlib -Tstm32f103c8.ld -Wl,--gc-sections,-Map=$(BUILD)/gbuck.map -lgcc -o $@
+	$(SIZE) $@
+$(BUILD)/gbuck.bin: $(BUILD)/gbuck.elf
+	$(OBJCOPY) -O binary $< $@
+$(BUILD)/gbuck.hex: $(BUILD)/gbuck.elf
+	$(OBJCOPY) -O ihex $< $@
+test:
+	mkdir -p build/tests
+	gcc -std=c11 -Wall -Wextra -Werror -g -fsanitize=address,undefined -Iinclude -DPOWER_STAGE_ALLOWED=1 src/app.c src/measurement.c tests/test_control.c -lm -o build/tests/control
