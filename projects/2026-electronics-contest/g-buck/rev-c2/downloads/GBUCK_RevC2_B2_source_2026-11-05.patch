--- /dev/null
+++ b/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/src/app.c
@@ -0,0 +1,293 @@
+#include "app.h"
+
+static i32 clamp(i32 x, i32 lo, i32 hi) {
+ return x < lo ? lo : (x > hi ? hi : x);
+}
+static u32 advance(u32 x) { return x == ~0u ? x : x + 1u; }
+static void enter(App *a, State state) { a->state = state; a->state_ms = 0; }
+static void outputs_off(App *a) { a->enable = 0; a->arm = 0; a->duty = 0; }
+static void clear_record(App *a) { a->last_fault = (FaultRecord){0}; }
+static void reset_control(App *a) {
+ outputs_off(a);
+ a->startup_ms = a->oc_ms = a->uv_ms = a->pre_ms = 0;
+ a->stable_ms = a->current_ms = 0;
+ a->target_mv = a->max_vout = a->cv_out = a->cc_out = 0;
+ a->cv_integral = a->cc_integral = 0;
+ a->cc_mode = a->output_rose = 0;
+}
+static u8 plausible(const Sample *s) {
+ /* ADC conversion should never approach these bounds. They also bound every
+  * fixed-point multiplication when a damaged/debug-written sample is used. */
+ return s && s->valid &&
+  s->vin >= -100000 && s->vin <= 100000 &&
+  s->iin >= -100000 && s->iin <= 100000 &&
+  s->vout >= -100000 && s->vout <= 100000 &&
+  s->iout >= -100000 && s->iout <= 100000 &&
+  s->il >= -100000 && s->il <= 100000 &&
+  s->vin_post >= -100000 && s->vin_post <= 100000;
+}
+static u8 post_ready(const Sample *s) {
+ return s->vin_post >= VIN_POST_MIN_MV &&
+  s->vin_post >= s->vin - PRECHARGE_GAP_MAX_MV &&
+  s->vin_post <= s->vin + PRECHARGE_GAP_MAX_MV;
+}
+static i32 output_floor(const App *a) {
+ i32 floor = a->vset / 4;
+ return floor < OUTPUT_FLOOR_MAX_MV ? floor : OUTPUT_FLOOR_MAX_MV;
+}
+static i32 rise_floor(const App *a) {
+ i32 floor = a->vset / 4;
+ return floor < STARTUP_RISE_MAX_MV ? floor : STARTUP_RISE_MAX_MV;
+}
+static i32 prebias_limit(const App *a) {
+ i32 limit = a->vset / 4;
+ return limit < PREBIAS_MAX_MV ? limit : PREBIAS_MAX_MV;
+}
+static u8 sampled_current_fault(const Sample *s) {
+ return s->iout > SAMPLED_IOUT_TRIP_MA || s->il > SAMPLED_IL_TRIP_MA ||
+        s->il < -SAMPLED_IL_TRIP_MA;
+}
+
+void app_init(App *a) {
+ *a = (App){0};
+ a->state = OFF;
+ a->vset = DEFAULT_VSET_MV;
+ a->iset = DEFAULT_ISET_MA;
+}
+
+void app_trip(App *a, Fault f) {
+ if (a->state == TRIPPED) { outputs_off(a); return; }
+ /* A record survives STOP and idle faults. Only an explicit new attempt or
+  * CLEAR_RECORD permits replacement, so repeated faults cannot erase cause. */
+ if (!a->last_fault.valid) {
+  const Sample *s = &a->last_sample;
+  FaultRecord *r = &a->last_fault;
+  r->valid = 1;
+  r->code = (u32)f;
+  r->state_before = (u32)a->state;
+  r->tick_ms = a->tick_ms;
+  r->startup_ms = a->startup_ms;
+  r->vout = s->vout; r->iout = s->iout; r->il = s->il;
+  r->vin = s->vin; r->vin_post = s->vin_post;
+  r->duty = a->duty; r->cv_out = a->cv_out; r->cc_out = a->cc_out;
+  r->flags = (s->valid && a->sample_seen ? RECORD_SAMPLE_VALID : 0u) |
+   (a->fault_n ? RECORD_FAULT_N : 0u) | (a->oc_n ? RECORD_OC_N : 0u) |
+   (a->enable ? RECORD_ENABLE : 0u) | (a->arm ? RECORD_ARM : 0u) |
+   (a->cc_mode ? RECORD_CC_MODE : 0u) |
+   (a->bypass_confirmed ? RECORD_BYPASS : 0u) |
+   (a->output_rose ? RECORD_OUTPUT_ROSE : 0u);
+  r->state_ms = a->state_ms;
+  r->target_mv = a->target_mv; r->max_vout = a->max_vout;
+ }
+ outputs_off(a);
+ a->fault = f;
+ a->bypass_confirmed = 0;
+ enter(a, TRIPPED);
+}
+
+CmdResult app_command(App *a, Command c, i32 value) {
+ switch (c) {
+ case CMD_NONE:
+  return CMD_OK;
+ case CMD_STOP:
+  reset_control(a);
+  a->fault = F_NONE;
+  a->bypass_confirmed = 0;
+  enter(a, OFF);
+  return CMD_OK;
+ case CMD_SET_V:
+ case CMD_SET_I:
+  if (a->state != OFF && a->state != TRIPPED) return CMD_BAD_STATE;
+  if (c == CMD_SET_V) {
+   if (value < VSET_MIN_MV || value > VSET_MAX_MV) return CMD_BAD_VALUE;
+   a->vset = value;
+  } else {
+   if (value < ISET_MIN_MA || value > ISET_MAX_MA) return CMD_BAD_VALUE;
+   a->iset = value;
+  }
+  return CMD_OK;
+ case CMD_CLEAR_RECORD:
+  if (a->state != OFF && a->state != READY && a->state != TRIPPED)
+   return CMD_BAD_STATE;
+  clear_record(a);
+  return CMD_OK;
+ case CMD_PRECHARGE:
+  if (a->state != OFF && a->state != TRIPPED) return CMD_BAD_STATE;
+  reset_control(a);
+  clear_record(a);
+  a->fault = F_NONE;
+  a->bypass_confirmed = 0;
+  enter(a, PRECHARGE);
+  return CMD_OK;
+ case CMD_CONFIRM_BYPASS:
+  if (a->state != READY) return CMD_BAD_STATE;
+  a->bypass_confirmed = 1;
+  return CMD_OK;
+ case CMD_START:
+  if (a->state != READY || !a->bypass_confirmed) return CMD_BAD_STATE;
+  if (!POWER_STAGE_ALLOWED) return CMD_LOCKED;
+  if (!a->sample_seen || !plausible(&a->last_sample)) {
+   app_trip(a, F_ADC); return CMD_BAD_STATE;
+  }
+  if (a->last_sample.vout > prebias_limit(a)) {
+   app_trip(a, F_PREBIAS); return CMD_BAD_STATE;
+  }
+  if (!a->fault_n) { app_trip(a, F_HARDWARE); return CMD_BAD_STATE; }
+  if (!a->oc_n) { app_trip(a, F_OC); return CMD_BAD_STATE; }
+  if (sampled_current_fault(&a->last_sample)) {
+   app_trip(a, F_CURRENT); return CMD_BAD_STATE;
+  }
+  if (a->last_sample.vin < VIN_MIN_MV || a->last_sample.vin > VIN_MAX_MV ||
+      !post_ready(&a->last_sample)) {
+   app_trip(a, F_INPUT); return CMD_BAD_STATE;
+  }
+  reset_control(a);
+  clear_record(a);
+  a->fault = F_NONE;
+  enter(a, ARMING);
+  return CMD_OK;
+ default:
+  return CMD_UNKNOWN;
+ }
+}
+
+static void regulate(App *a, const Sample *s) {
+ i32 ev = a->target_mv - s->vout;
+ i32 ei = a->iset - s->iout;
+ i32 ff = a->target_mv * 10000 / s->vin_post;
+ i32 cv_p = CV_KP * ev;
+ i32 cv_next = clamp(a->cv_integral + CV_KI * ev,
+                     -CV_TRIM_MAX_BP * 1000, CV_TRIM_MAX_BP * 1000);
+ i32 trim = (cv_p + cv_next) / 1000;
+ i32 cv_request = ff + clamp(trim, -CV_TRIM_MAX_BP, CV_TRIM_MAX_BP);
+ if (!((trim > CV_TRIM_MAX_BP && ev > 0) ||
+       (trim < -CV_TRIM_MAX_BP && ev < 0) ||
+       (cv_request > DUTY_MAX && ev > 0) || (cv_request < 0 && ev < 0)))
+  a->cv_integral = cv_next;
+ trim = clamp((cv_p + a->cv_integral) / 1000,
+              -CV_TRIM_MAX_BP, CV_TRIM_MAX_BP);
+ a->cv_out = clamp(ff + trim, 0, DUTY_MAX);
+
+ /* Below current demand the CC regulator tracks actual selected duty.
+  * It therefore starts with useful headroom, rather than slowly opening from
+  * zero while a zero-current output is waiting for the CV regulator. */
+ if ((!a->cc_mode && s->iout < a->iset) ||
+     s->iout < a->iset - CC_RELEASE_MARGIN_MA) {
+  a->cc_out = a->cv_out;
+  a->cc_mode = 0;
+ } else {
+  i32 next = a->cc_integral + CC_KI * ei;
+  i32 request = (CC_KP * ei + next) / 1000;
+  if (!((request > DUTY_MAX && ei > 0) || (request < 0 && ei < 0)))
+   a->cc_integral = next;
+  a->cc_out = clamp((CC_KP * ei + a->cc_integral) / 1000, 0, DUTY_MAX);
+  a->cc_mode = a->cc_out < a->cv_out;
+ }
+ i32 selected = a->cc_mode ? a->cc_out : a->cv_out;
+ if (selected > a->duty + DUTY_RISE_MAX_BP_PER_MS)
+  selected = a->duty + DUTY_RISE_MAX_BP_PER_MS;
+ a->duty = clamp(selected, 0, DUTY_MAX);
+ if (a->cc_mode) {
+  /* Back-calculate the inactive voltage loop; its bounded trim never winds
+   * up against the selected current limiter. */
+  a->cv_integral = clamp((a->duty - ff) * 1000 - cv_p,
+                         -CV_TRIM_MAX_BP * 1000, CV_TRIM_MAX_BP * 1000);
+ } else {
+  /* Includes the slew limiter, so CC takeover starts from applied demand. */
+  a->cc_integral = a->duty * 1000 - CC_KP * ei;
+ }
+}
+
+void app_tick(App *a, const Sample *s, u8 fault_n, u8 oc_n) {
+ a->tick_ms = advance(a->tick_ms);
+ a->fault_n = fault_n != 0;
+ a->oc_n = oc_n != 0;
+ if (s) { a->last_sample = *s; a->sample_seen = 1; }
+ else { a->last_sample.valid = 0; a->sample_seen = 0; }
+ if (a->state == TRIPPED) { outputs_off(a); return; }
+ if (!fault_n) { app_trip(a, F_HARDWARE); return; }
+ if (a->state == OFF) { outputs_off(a); return; }
+ if (a->state < PRECHARGE || a->state > RUN) {
+  app_trip(a, F_TIMING); return;
+ }
+ a->state_ms = advance(a->state_ms);
+ if (!plausible(s)) { app_trip(a, F_ADC); return; }
+ if (s->vin < VIN_MIN_MV || s->vin > VIN_MAX_MV) {
+  app_trip(a, F_INPUT); return;
+ }
+ if (s->vout > OUTPUT_OV_MV) { app_trip(a, F_OV); return; }
+ if (a->state == PRECHARGE) {
+  outputs_off(a);
+  if (post_ready(s)) {
+   a->pre_ms = advance(a->pre_ms);
+   if (a->pre_ms >= PRECHARGE_MS) enter(a, READY);
+  } else a->pre_ms = 0;
+  return;
+ }
+ if (a->state == READY) {
+  outputs_off(a);
+  if (!post_ready(s)) {
+   a->pre_ms = 0; a->bypass_confirmed = 0; enter(a, PRECHARGE);
+  }
+  return;
+ }
+ if (!post_ready(s)) { app_trip(a, F_INPUT); return; }
+ if (a->state == ARMING) {
+  /* Recheck the fresh scan before the first physical ARM output. */
+  if (s->vout > prebias_limit(a)) { app_trip(a, F_PREBIAS); return; }
+  if (!oc_n) { app_trip(a, F_OC); return; }
+  if (sampled_current_fault(s)) { app_trip(a, F_CURRENT); return; }
+  outputs_off(a);
+  if (a->state_ms <= ARM_MS) a->arm = 1;
+  else if (a->state_ms > ARM_MS + DRIVER_SETTLE_MS) {
+   enter(a, STARTUP); a->enable = 1;
+  }
+  return;
+ }
+ a->arm = 0;
+ a->enable = 1;
+ if (!oc_n) {
+  a->oc_ms = advance(a->oc_ms);
+  if (a->oc_ms >= OC_DELAY_MS) { app_trip(a, F_OC); return; }
+ } else a->oc_ms = 0;
+ if (sampled_current_fault(s)) {
+  a->current_ms = advance(a->current_ms);
+  if (a->current_ms >= SAMPLED_CURRENT_DELAY_MS) {
+   app_trip(a, F_CURRENT); return;
+  }
+ } else a->current_ms = 0;
+ if (s->vout > a->max_vout) a->max_vout = s->vout;
+ if (s->vout >= output_floor(a)) a->output_rose = 1;
+ if ((a->state == RUN || a->output_rose) && s->vout < output_floor(a)) {
+  a->uv_ms = advance(a->uv_ms);
+  if (a->uv_ms >= UV_DELAY_MS) { app_trip(a, F_LOW_OUTPUT); return; }
+ } else a->uv_ms = 0;
+
+ if (a->state == STARTUP) {
+  a->startup_ms = advance(a->startup_ms);
+  if (a->startup_ms >= STARTUP_NO_RISE_MS && a->max_vout < rise_floor(a)) {
+   app_trip(a, F_START_NO_RISE); return;
+  }
+  i32 tolerance = a->vset * STARTUP_V_TOLERANCE_PERCENT / 100;
+  if (tolerance < STARTUP_V_TOLERANCE_MIN_MV)
+   tolerance = STARTUP_V_TOLERANCE_MIN_MV;
+  i32 current_tolerance = a->iset * STARTUP_CC_TOLERANCE_PERCENT / 100;
+  u8 voltage_ok = s->vout >= a->vset - tolerance &&
+                  s->vout <= a->vset + tolerance &&
+                  s->iout >= -current_tolerance &&
+                  s->iout <= a->iset + current_tolerance;
+  u8 current_ok = s->iout >= a->iset - current_tolerance &&
+                  s->iout <= a->iset + current_tolerance &&
+                  s->vout >= output_floor(a) && s->vout <= a->vset + tolerance;
+  if (a->startup_ms >= STARTUP_RAMP_MS && (voltage_ok || current_ok))
+   a->stable_ms = advance(a->stable_ms);
+  else a->stable_ms = 0;
+  if (a->stable_ms >= STARTUP_SETTLE_MS) enter(a, RUN);
+  else if (a->startup_ms >= STARTUP_TIMEOUT_MS) {
+   app_trip(a, F_START_TIMEOUT); return;
+  }
+  a->target_mv = a->startup_ms < STARTUP_RAMP_MS ?
+    (i32)(a->startup_ms * (u32)a->vset / STARTUP_RAMP_MS) : a->vset;
+ } else a->target_mv = a->vset;
+ regulate(a, s);
+}
diff --git a/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/src/board.c b/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/src/board.c
