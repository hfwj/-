--- /dev/null
+++ b/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/src/main.c
@@ -0,0 +1,92 @@
+#include "board.h"
+#include "diag.h"
+static App app;
+static Sample sample;
+static volatile u32 ticks,hard_fault,fault_irq_count;
+static volatile u32 platform_ready;
+static u32 scans,failures;
+u32 millis(void){return ticks;}
+void delay_ms(u32 ms){u32 start=ticks;while(ticks-start<ms){__asm volatile("nop");}}
+#ifdef HOST_TEST
+extern void platform_test_lock(void),platform_test_unlock(void);
+static void lock(void){platform_test_lock();}
+static void unlock(void){platform_test_unlock();}
+#else
+static void lock(void){__asm volatile("cpsid i":::"memory");}
+static void unlock(void){__asm volatile("cpsie i":::"memory");}
+#endif
+static HwSnapshot hardware(void){
+ HwSnapshot h={REG(GPIOB+8),REG(TIM1+0x34),REG(TIM1+0x44),
+               REG(TIM1),REG(TIM1+0x20),REG(GPIOB),hard_fault};
+ return h;
+}
+void EXTI15_10_IRQHandler(void){
+ if(REG(0x40010414)&(1u<<10)){
+  board_kill();hard_fault=1;fault_irq_count++;REG(0x40010414)=1u<<10;
+ }
+}
+void SysTick_Handler(void){
+ const u32 start=REG(0xE0001004);static u32 previous;
+ const HwSnapshot before=hardware();
+ const u8 requested_arm=app.arm,requested_en=app.enable;
+ ticks++;
+ u16 raw[6];
+ if(board_sample(raw)){
+  adc_convert(raw,&sample);
+  for(u32 i=0;i<6;i++)debug_adc_raw[i]=raw[i];
+  scans++;
+ }else{sample.valid=0;failures++;}
+ /* VALUE first, CMD last. Only the IRQ mutates the controller. */
+ u32 requested_cmd=debug_window.w[D_CMD];
+ if(requested_cmd){
+  i32 value=(i32)debug_window.w[D_VALUE];debug_window.w[D_CMD]=0;
+  lock();
+  CmdResult result;
+  if(!platform_ready && (requested_cmd==CMD_PRECHARGE ||
+     requested_cmd==CMD_CONFIRM_BYPASS || requested_cmd==CMD_START))result=CMD_BAD_STATE;
+  else result=app_command(&app,(Command)requested_cmd,value);
+  if(result==CMD_OK && requested_cmd==CMD_PRECHARGE){
+   if((REG(GPIOB+8)&(1u<<10)) && !(REG(0x40010414)&(1u<<10)))hard_fault=0;
+  }
+  unlock();
+  if(result==CMD_OK && (requested_cmd==CMD_PRECHARGE || requested_cmd==CMD_CLEAR_RECORD || requested_cmd==CMD_START))diag_reset_trace();
+  diag_ack((Command)requested_cmd,result);
+ }
+ /* A 1 ms delayed pad readback: detects a local low/stuck output, not a
+  * disconnected cable or the remote SAFE_OK/DRV_EN path. */
+ if(hard_fault)app_trip(&app,F_HARDWARE);
+ else if(POWER_STAGE_ALLOWED && requested_arm && !(before.idr&2u))app_trip(&app,F_ARM_PIN);
+ else if(POWER_STAGE_ALLOWED && requested_en && !(before.idr&1u))app_trip(&app,F_EN_PIN);
+ if(previous && start-previous>CPU_HZ/1000*2)app_trip(&app,F_TIMING);
+ previous=start;
+ app_tick(&app,&sample,(REG(GPIOB+8)&(1u<<10))!=0,(REG(GPIOB+8)&(1u<<11))!=0);
+ if(REG(0xE0001004)-start>CPU_HZ/1000)app_trip(&app,F_TIMING);
+ lock();
+ if(hard_fault || !(REG(GPIOB+8)&(1u<<10)) || (REG(0x40010414)&(1u<<10)))app_trip(&app,F_HARDWARE);
+ board_outputs(&app);
+ diag_update(&app,&sample,&before,REG(GPIOB+8),scans,failures,fault_irq_count,REG(0xE0001004)-start);
+ u32 elapsed=REG(0xE0001004)-start;
+ if(elapsed>debug_window.w[D_ISR_CYCLES])debug_window.w[D_ISR_CYCLES]=elapsed;
+ if(elapsed>CPU_HZ/1000){
+  app_trip(&app,F_TIMING);board_kill();
+  diag_update(&app,&sample,&before,REG(GPIOB+8),scans,failures,fault_irq_count,elapsed);
+ }
+ unlock();
+}
+int main(void){
+ app_init(&app);diag_init(); /* NOLOAD diagnostic memory explicitly cleared. */
+ REG(0xE000EDFC)|=1u<<24;REG(0xE0001000)|=1;
+ board_init();lcd_init();
+ /* Do not freeze IWDG on debugger halt: halted control must not leave PWM. */
+ REG(0xE0042004)&=~(1u<<8);
+ REG(0x40003000)=0x5555;REG(0x40003004)=3;REG(0x40003008)=312;
+ REG(0x40003000)=0xAAAA;REG(0x40003000)=0xCCCC;
+ lock();platform_ready=1;diag_set_ready();unlock();
+ for(;;){
+  App a;Sample s;
+  lock();a=app;s=sample;unlock();
+  lcd_update(&a,&s);
+  REG(0x40003000)=0xAAAA;
+  delay_ms(50);
+ }
+}
diff --git a/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/src/measurement.c b/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/src/measurement.c
new file mode 100644
--- /dev/null
+++ b/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/src/measurement.c
@@ -0,0 +1,19 @@
+#include "app.h"
+i32 adc_offset[6]={0,0,0,0,0,0};
+i32 adc_gain_ppm[6]={1000000,1000000,1000000,1000000,1000000,1000000};
+void adc_convert(const u16 raw[6],Sample *s){
+ i32 x[6]; s->valid=1;
+ for(u32 n=0;n<6;n++){
+  if(raw[n]>=4090)s->valid=0;
+  /* VIN/VOUT/VIN_POST: 11:1; IIN/IOUT: 1V/A;
+   * IL: 0.5V/A around VDDA/2, INA240A1, 25mOhm. */
+  if(n==0 || n==2 || n==5)x[n]=(i32)raw[n]*ADC_VDDA_MV*11/4095;
+  else if(n==4)x[n]=((i32)raw[n]*ADC_VDDA_MV/4095-ADC_VDDA_MV/2)*2;
+  else x[n]=(i32)raw[n]*ADC_VDDA_MV/4095;
+  /* 64 bit intermediate prevents calibration multiplication overflow. */
+  x[n]=(i32)(((long long)x[n]+adc_offset[n])*adc_gain_ppm[n]/1000000);
+ }
+ s->vin=x[0];s->iin=x[1];s->vout=x[2];s->iout=x[3];s->il=x[4];s->vin_post=x[5];
+ /* ADC disconnected/stuck-at-zero cannot satisfy the arm prerequisites. */
+ if(raw[4]<100 || raw[4]>3995)s->valid=0;
+}
diff --git a/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/src/startup.c b/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/src/startup.c
new file mode 100644
--- /dev/null
+++ b/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/src/startup.c
@@ -0,0 +1,22 @@
+#include "board.h"
+extern u32 _estack,_sidata,_sdata,_edata,_sbss,_ebss;
+extern int main(void);
+extern void SysTick_Handler(void),EXTI15_10_IRQHandler(void);
+void Default_Handler(void){board_kill();while(1){}}
+void Reset_Handler(void){
+ u32 *source=&_sidata;
+ for(u32 *p=&_sdata;p<&_edata;)*p++=*source++;
+ for(u32 *p=&_sbss;p<&_ebss;)*p++=0;
+ main();Default_Handler();
+}
+__attribute__((section(".isr_vector"),used))
+void (* const vectors[76])(void)={
+ [0]=(void (*)(void))(&_estack),[1]=Reset_Handler,
+ [2]=Default_Handler,[3]=Default_Handler,[4]=Default_Handler,
+ [5]=Default_Handler,[6]=Default_Handler,[11]=Default_Handler,
+ [12]=Default_Handler,[14]=Default_Handler,[15]=SysTick_Handler,
+ [56]=EXTI15_10_IRQHandler
+};
+/* Freestanding compiler aggregate helpers. */
+void *memset(void *d,int v,unsigned int n){u8 *p=d;while(n--)*p++=(u8)v;return d;}
+void *memcpy(void *d,const void *s,unsigned int n){u8 *p=d;const u8 *q=s;while(n--)*p++=*q++;return d;}
diff --git a/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/stm32f103c8.ld b/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/stm32f103c8.ld
new file mode 100644
--- /dev/null
+++ b/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/stm32f103c8.ld
@@ -0,0 +1,18 @@
+ENTRY(Reset_Handler)
+MEMORY { FLASH (rx) : ORIGIN = 0x08000000, LENGTH = 64K
+         RAM (rwx) : ORIGIN = 0x20000000, LENGTH = 20K }
+_estack = ORIGIN(RAM) + LENGTH(RAM);
+SECTIONS {
+ .isr_vector : { KEEP(*(.isr_vector)) } > FLASH
+ .text : { *(.text*) *(.rodata*) . = ALIGN(4); } > FLASH
+ .ARM.exidx : { *(.ARM.exidx*) } > FLASH
+ .swd_mailbox 0x20000000 (NOLOAD) : { KEEP(*(.swd_mailbox)) } > RAM
+ .swd_trace 0x20000100 (NOLOAD) : { KEEP(*(.swd_trace)) } > RAM
+ ASSERT(SIZEOF(.swd_mailbox)==0x100,"SWD ABI window size mismatch")
+ ASSERT(SIZEOF(.swd_trace)==0x2800,"SWD trace size mismatch")
+ _sidata = LOADADDR(.data);
+ .data : { . = ALIGN(4); _sdata = .; *(.data*) . = ALIGN(4); _edata = .; } > RAM AT > FLASH
+ .bss (NOLOAD) : { . = ALIGN(4); _sbss = .; *(.bss*) *(COMMON) . = ALIGN(4); _ebss = .; } > RAM
+ ASSERT(_ebss + 2048 < _estack,"Need 2KB stack margin")
+ /DISCARD/ : { *(.comment) *(.note*) }
+}
diff --git a/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/tests/test_adc_registers.c b/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/tests/test_adc_registers.c
new file mode 100644
--- /dev/null
+++ b/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/tests/test_adc_registers.c
@@ -0,0 +1,78 @@
+/* Host register-model regression, NOT a physical ADC/settling-time test.
+ * ADC offsets/channel fields follow ST's stm32f103xb.h (CMSIS device F1).
+ * Compile the real board driver with a narrow register-access override.
+ */
+#define _GNU_SOURCE
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <sys/mman.h>
+#include "app.h"
+
+static volatile u32 *mock_reg(u32 address);
+#define REG(a) (*mock_reg(a))
+#include "../src/board.c"
+
+static int sampling, stalled_channel = -1;
+static u32 reads, read_channels[6];
+static const u16 inputs[7] = {1675, 12, 1000, 24, 2048, 4095, 1660};
+#define DIRECT(a) (*(volatile u32 *)(uintptr_t)(a))
+
+static volatile u32 *mock_reg(u32 address){
+ assert((address >= 0x40010000u && address < 0x40024000u) ||
+        (address >= 0xE000E000u && address < 0xE0010000u));
+ if(address == RCC){
+  if(DIRECT(RCC)&1u) DIRECT(RCC)|=2u;
+  if(DIRECT(RCC)&(1u<<24)) DIRECT(RCC)|=1u<<25;
+ }
+ if(address == RCC+4){
+  DIRECT(RCC+4)=(DIRECT(RCC+4)&~12u)|((DIRECT(RCC+4)&3u)<<2);
+ }
+ if(address == ADC1+8) DIRECT(ADC1+8)&=~12u; /* CAL/RSTCAL complete */
+ if(sampling && address == ADC1 && (DIRECT(ADC1+8)&(1u<<22))){
+  u32 channel=DIRECT(ADC1+0x34)&31u;
+  assert(channel<7);
+  if((int)channel != stalled_channel){
+   DIRECT(ADC1+0x4C)=inputs[channel];
+   DIRECT(ADC1+8)&=~(1u<<22);
+   DIRECT(ADC1)|=2u;
+  }
+ }
+ if(sampling && address == ADC1+0x4C){
+  assert(reads<6);
+  read_channels[reads++]=DIRECT(ADC1+0x34)&31u;
+  DIRECT(ADC1)&=~2u; /* DR read clears EOC */
+ }
+ return (volatile u32 *)(uintptr_t)address;
+}
+
+int main(void){
+ void *a=mmap((void *)(uintptr_t)0x40010000u,0x14000,
+              PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED,-1,0);
+ void *b=mmap((void *)(uintptr_t)0xE000E000u,0x2000,
+              PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED,-1,0);
+ assert(a!=MAP_FAILED && b!=MAP_FAILED);
+ DIRECT(GPIOA)=DIRECT(GPIOA+4)=0x44444444u;
+ DIRECT(GPIOB)=DIRECT(GPIOB+4)=0x44444444u;
+ board_init();
+ /* SMPR2 at +0x10 owns channels 0..9; SMPR1 at +0x0C owns 10..17. */
+ for(u32 c=0;c<=6;c++) if(c!=5) assert(((DIRECT(ADC1+0x10)>>(3*c))&7u)==7u);
+ assert(((DIRECT(ADC1+0x10)>>15)&7u)==0u); /* PA5 is LCD SCK, not ADC */
+ assert(DIRECT(ADC1+0x0C)==0u);
+ for(u32 c=0;c<=6;c++) if(c!=5) assert(((DIRECT(GPIOA)>>(4*c))&15u)==0);
+ assert(!(DIRECT(TIM1+0x44)&(1u<<15)) && DIRECT(TIM1+0x34)==0);
+ u16 raw[6]; const u32 channels[6]={0,1,2,3,4,6};
+ sampling=1;
+ assert(board_sample(raw));
+ assert(reads==6);
+ for(u32 i=0;i<6;i++){
+  assert(read_channels[i]==channels[i]);
+  assert(raw[i]==inputs[channels[i]]);
+ }
+ Sample s;adc_convert(raw,&s);
+ assert(s.valid && s.vin>14000 && s.vin_post>14000);
+ reads=0;stalled_channel=0;
+ assert(!board_sample(raw) && reads==0);
+ munmap(a,0x14000);munmap(b,0x2000);
+ puts("PASS: actual board driver SMPR2/channel mapping, analog GPIO, disabled PWM, six-channel reads and ADC timeout (host register model only)");
+}
diff --git a/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/tests/test_control.c b/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/tests/test_control.c
new file mode 100644
--- /dev/null
+++ b/projects/2026-electronics-contest/g-buck/rev-c2/firmware/b2/tests/test_control.c
@@ -0,0 +1,740 @@
+#include <assert.h>
+#include <limits.h>
+#include <math.h>
+#include <stdio.h>
+#include "app.h"
+
+/* This file exercises the real production app.c. Scripted ADC replays test
+ * interlocks and protections; the small averaged LC model below is a separate,
+ * approximate control regression. Neither is evidence of hardware safety. */
+static const Sample cold = {13800, 0, 0, 0, 0, 13800, 1};
+
+static void off(const App *a)
+{
+    assert(!a->enable && !a->arm && a->duty == 0);
+}
+
+static void bounded(const App *a)
+{
+    assert(a->duty >= 0 && a->duty <= 2500);
+    assert(!(a->enable && a->arm));
+    if (!a->enable) assert(a->duty == 0);
+}
+
+static void ticks(App *a, const Sample *s, unsigned n, u8 fault_n, u8 oc_n)
+{
+    while (n--) {
+        app_tick(a, s, fault_n, oc_n);
+        bounded(a);
+    }
+}
+
+static void ready_with(App *a, const Sample *s)
+{
+    app_init(a);
+    assert(app_command(a, CMD_PRECHARGE, 0) == CMD_OK);
+    ticks(a, s, PRECHARGE_MS - 1, 1, 1);
+    assert(a->state == PRECHARGE);
+    off(a);
+    ticks(a, s, 1, 1, 1);
+    assert(a->state == READY && !a->bypass_confirmed);
+    off(a);
+}
+
+static void ready(App *a)
+{
+    ready_with(a, &cold);
+}
+
+static void request_start(App *a)
+{
+    assert(a->state == READY);
+    assert(app_command(a, CMD_CONFIRM_BYPASS, 0) == CMD_OK);
+    assert(a->bypass_confirmed);
+    assert(app_command(a, CMD_START, 0) == CMD_OK);
+    assert(a->state == ARMING);
+    off(a);
+}
+
+static void startup(App *a)
+{
+    ready(a);
+    request_start(a);
+    for (unsigned n = 0; n < ARM_MS + DRIVER_SETTLE_MS + 3; ++n) {
+        ticks(a, &cold, 1, 1, 1);
+        if (a->state == STARTUP) break;
+        assert(a->state == ARMING);
+    }
+    assert(a->state == STARTUP && a->enable && !a->arm);
+}
+
+/* A plausible measured response for protection/state tests. Actual dynamics
+ * are checked independently by plant_run(); this helper does not model them. */
+static void running(App *a)
+{
+    Sample s = cold;
+    startup(a);
+    for (unsigned ms = 1; ms <= STARTUP_TIMEOUT_MS; ++ms) {
+        s.vout = ms < STARTUP_RAMP_MS ?
+            (i32)(2000u * ms / STARTUP_RAMP_MS) : 2000;
+        s.iout = s.vout / 10;
+        s.il = s.iout;
+        ticks(a, &s, 1, 1, 1);
+        assert(a->state == STARTUP || a->state == RUN);
+        if (a->state == RUN) return;
+    }
+    assert(!"a sustained measured response must complete startup");
+}
+
+static void record_equal(const FaultRecord *a, const FaultRecord *b)
+{
+#define SAME(field) assert(a->field == b->field)
+    SAME(valid); SAME(code); SAME(state_before); SAME(tick_ms);
+    SAME(startup_ms); SAME(vout); SAME(iout); SAME(il); SAME(vin);
+    SAME(vin_post); SAME(duty); SAME(cv_out); SAME(cc_out); SAME(flags);
+    SAME(state_ms); SAME(target_mv); SAME(max_vout);
+#undef SAME
+}
+
+static void test_commands_and_interlocks(void)
+{
+    App a;
+    assert(POWER_STAGE_ALLOWED == 1);
+    assert(DUTY_MAX == 2500);
+    assert(OFF == 0 && PRECHARGE == 1 && READY == 2 && ARMING == 3);
+    assert(STARTUP == 4 && RUN == 5 && TRIPPED == 6);
+    assert(CMD_PRECHARGE == 1 && CMD_CONFIRM_BYPASS == 2 && CMD_START == 3);
+    assert(CMD_STOP == 4 && CMD_SET_V == 5 && CMD_SET_I == 6);
+    assert(CMD_CLEAR_RECORD == 7);
+    app_init(&a);
+    assert(a.state == OFF && a.fault == F_NONE && !a.last_fault.valid);
+    assert(a.vset == 2000 && a.iset == 200);
+    off(&a);
+    assert(app_command(&a, CMD_START, 0) == CMD_BAD_STATE);
+    assert(app_command(&a, CMD_CONFIRM_BYPASS, 0) == CMD_BAD_STATE);
+    assert(app_command(&a, (Command)INT_MAX, 0) == CMD_UNKNOWN);
+    assert(app_command(&a, (Command)INT_MIN, 0) == CMD_UNKNOWN);
+    off(&a);
+
+    const i32 bad_v[] = {INT_MIN, -1, 0, 199, 2001, INT_MAX};
+    const i32 bad_i[] = {INT_MIN, -1, 0, 99, 201, INT_MAX};
+    for (unsigned n = 0; n < sizeof bad_v / sizeof bad_v[0]; ++n) {
+        assert(app_command(&a, CMD_SET_V, bad_v[n]) == CMD_BAD_VALUE);
+        assert(app_command(&a, CMD_SET_I, bad_i[n]) == CMD_BAD_VALUE);
+        assert(a.vset == 2000 && a.iset == 200);
+    }
+    assert(app_command(&a, CMD_SET_V, 200) == CMD_OK);
+    assert(app_command(&a, CMD_SET_I, 100) == CMD_OK);
+    assert(a.vset == 200 && a.iset == 100);
+    assert(app_command(&a, CMD_SET_V, 2000) == CMD_OK);
+    assert(app_command(&a, CMD_SET_I, 200) == CMD_OK);
+
+    assert(app_command(&a, CMD_PRECHARGE, 0) == CMD_OK);
+    assert(app_command(&a, CMD_CONFIRM_BYPASS, 0) == CMD_BAD_STATE);
+    assert(app_command(&a, CMD_START, 0) == CMD_BAD_STATE);
+    assert(app_command(&a, CMD_SET_V, 1000) == CMD_BAD_STATE);
+    assert(app_command(&a, CMD_SET_I, 100) == CMD_BAD_STATE);
+    ticks(&a, &cold, PRECHARGE_MS, 1, 1);
+    assert(a.state == READY && !a.bypass_confirmed);
+    assert(app_command(&a, CMD_START, 0) == CMD_BAD_STATE);
+    off(&a);
+
+    /* A momentary post-precharge droop invalidates manual confirmation. */
+    assert(app_command(&a, CMD_CONFIRM_BYPASS, 0) == CMD_OK);
+    Sample droop = cold;
+    droop.vin_post = 11000;
+    ticks(&a, &droop, 1, 1, 1);
+    assert(!a.bypass_confirmed);
+    assert(app_command(&a, CMD_START, 0) != CMD_OK);
+    off(&a);
+
+    /* Continuous good precharge time is required; partial intervals do not
+     * accumulate across a bad sample. */
+    ready(&a);
+    assert(app_command(&a, CMD_STOP, 0) == CMD_OK);
+    assert(app_command(&a, CMD_PRECHARGE, 0) == CMD_OK);
+    ticks(&a, &cold, PRECHARGE_MS - 1, 1, 1);
+    ticks(&a, &droop, 1, 1, 1);
+    ticks(&a, &cold, PRECHARGE_MS - 1, 1, 1);
+    assert(a.state == PRECHARGE);
+    ticks(&a, &cold, 1, 1, 1);
+    assert(a.state == READY && !a.bypass_confirmed);
+}
+
+static void test_arm_timing_and_start_edit_lock(void)
+{
+    App a;
+    ready(&a);
+    request_start(&a);
+    assert(app_command(&a, CMD_SET_V, 1500) == CMD_BAD_STATE);
+    assert(app_command(&a, CMD_SET_I, 100) == CMD_BAD_STATE);
+    assert(a.vset == 2000 && a.iset == 200);
+    for (unsigned n = 0; n < ARM_MS; ++n) {
+        ticks(&a, &cold, 1, 1, 1);
+        assert(a.state == ARMING && a.arm && !a.enable && !a.duty);
+    }
+    for (unsigned n = 0; n < DRIVER_SETTLE_MS; ++n) {
+        ticks(&a, &cold, 1, 1, 1);
+        assert(a.state == ARMING);
+        off(&a);
+    }
+    ticks(&a, &cold, 1, 1, 1);
+    assert(a.state == STARTUP && a.enable && !a.arm);
+    assert(app_command(&a, CMD_SET_V, 1500) == CMD_BAD_STATE);
+    assert(app_command(&a, CMD_SET_I, 100) == CMD_BAD_STATE);
+}
+
+static void test_input_and_prebias_boundaries(void)
+{
+    App a;
+    Sample s = cold;
+    s.vin = 12000;
+    s.vin_post = 11000;
+    ready_with(&a, &s);
+    request_start(&a);
+    ticks(&a, &s, 1, 1, 1);
+    assert(a.state == ARMING);
+
+    s = cold;
+    s.vin = s.vin_post = 16000;
+    ready_with(&a, &s);
+    request_start(&a);
+    ticks(&a, &s, 1, 1, 1);
+    assert(a.state == ARMING);
+
+    const i32 bad_vin[] = {11999, 16001};
+    for (unsigned n = 0; n < sizeof bad_vin / sizeof bad_vin[0]; ++n) {
+        startup(&a);
+        s = cold;
+        s.vin = bad_vin[n];
+        ticks(&a, &s, 1, 1, 1);
+        assert(a.state == TRIPPED && a.fault == F_INPUT);
+        off(&a);
+    }
+    startup(&a);
+    s = cold;
+    s.vin_post = 10999;
+    ticks(&a, &s, 1, 1, 1);
+    assert(a.state == TRIPPED && a.fault == F_INPUT);
+    off(&a);
+
+    s = cold;
+    s.vout = 100;
+    ready_with(&a, &s);
+    request_start(&a);
+    ticks(&a, &s, 1, 1, 1);
+    assert(a.state == ARMING);
+
+    s.vout = 101;
+    ready_with(&a, &s);
+    assert(app_command(&a, CMD_CONFIRM_BYPASS, 0) == CMD_OK);
+    assert(app_command(&a, CMD_START, 0) != CMD_OK);
+    assert(a.state == TRIPPED && a.fault == F_PREBIAS);
+    off(&a);
+
+    /* At a 200 mV setpoint, the discharged-output boundary is Vset/4. */
+    s = cold;
+    s.vout = 50;
+    ready_with(&a, &s);
+    assert(app_command(&a, CMD_STOP, 0) == CMD_OK);
+    assert(app_command(&a, CMD_SET_V, 200) == CMD_OK);
+    assert(app_command(&a, CMD_PRECHARGE, 0) == CMD_OK);
+    ticks(&a, &s, PRECHARGE_MS, 1, 1);
+    request_start(&a);
+    ticks(&a, &s, 1, 1, 1);
+    assert(a.state == ARMING);
+    assert(app_command(&a, CMD_STOP, 0) == CMD_OK);
+    s.vout = 51;
+    assert(app_command(&a, CMD_PRECHARGE, 0) == CMD_OK);
+    ticks(&a, &s, PRECHARGE_MS, 1, 1);
+    assert(app_command(&a, CMD_CONFIRM_BYPASS, 0) == CMD_OK);
+    assert(app_command(&a, CMD_START, 0) != CMD_OK);
+    assert(a.state == TRIPPED && a.fault == F_PREBIAS);
+    off(&a);
+
+    /* A new output appearing after the last READY sample is also blocked. */
+    ready(&a);
+    request_start(&a);
+    s = cold;
+    s.vout = 101;
+    ticks(&a, &s, 1, 1, 1);
+    assert(a.state == TRIPPED && a.fault == F_PREBIAS);
+    off(&a);
+}
+
+static void test_current_before_arm_or_enable(void)
+{
+    assert(SAMPLED_IOUT_TRIP_MA == 400);
+    assert(SAMPLED_IL_TRIP_MA == 800);
+    for (unsigned channel = 0; channel < 3; ++channel) {
+        App a;
+        Sample limit = cold;
+        if (channel == 0) limit.iout = 400;
+        else if (channel == 1) limit.il = 800;
+        else limit.il = -800;
+
+        /* Equality is allowed both in the last READY sample and in the
+         * fresh ARMING scan; EN remains low throughout the ARM pulse. */
+        ready_with(&a, &limit);
+        request_start(&a);
+        ticks(&a, &limit, 1, 1, 1);
+        assert(a.state == ARMING && a.arm && !a.enable && !a.duty);
+        assert(app_command(&a, CMD_STOP, 0) == CMD_OK);
+        off(&a);
+
+        Sample over = limit;
+        if (channel == 0) ++over.iout;
+        else if (channel == 1) ++over.il;
+        else --over.il;
+
+        /* A known unsafe current must reject START before any ARM output. */
+        ready_with(&a, &over);
+        assert(app_command(&a, CMD_CONFIRM_BYPASS, 0) == CMD_OK);
+        assert(app_command(&a, CMD_START, 0) != CMD_OK);
+        assert(a.state == TRIPPED && a.fault == F_CURRENT);
+        assert(a.last_fault.valid && a.last_fault.state_before == READY);
+        assert(a.last_fault.code == F_CURRENT && !a.last_fault.duty);
+        assert(!(a.last_fault.flags & (RECORD_ARM | RECORD_ENABLE)));
+        off(&a);
+
+        /* The ADC scan may change between START and the first ARM tick. */
+        ready(&a);
+        request_start(&a);
+        ticks(&a, &over, 1, 1, 1);
+        assert(a.state == TRIPPED && a.fault == F_CURRENT);
+        assert(a.last_fault.state_before == ARMING);
+        assert(!(a.last_fault.flags & (RECORD_ARM | RECORD_ENABLE)));
+        off(&a);
+
+        /* A later ARMING sample also trips immediately and records the
+         * already asserted ARM level before the outputs are cleared. */
+        ready(&a);
+        request_start(&a);
+        ticks(&a, &cold, 1, 1, 1);
+        assert(a.arm && !a.enable);
+        ticks(&a, &over, 1, 1, 1);
+        assert(a.state == TRIPPED && a.fault == F_CURRENT);
+        assert(a.last_fault.state_before == ARMING);
+        assert(a.last_fault.flags & RECORD_ARM);
+        assert(!(a.last_fault.flags & RECORD_ENABLE));
+        off(&a);
+    }
+}
+
+static void test_no_feedback_and_response_gating(void)
+{
+    App a;
+    Sample replay = cold;
+    unsigned elapsed = 0;
+    int saw_pwm = 0;
+    startup(&a);
+    while (a.state != TRIPPED && elapsed <= STARTUP_NO_RISE_MS + 2) {
+        ticks(&a, &replay, 1, 1, 1);
+        saw_pwm |= a.enable && a.duty > 0;
+        ++elapsed;
+    }
+    assert(saw_pwm);
+    assert(a.state == TRIPPED && a.fault == F_START_NO_RISE);
+    assert(elapsed <= STARTUP_NO_RISE_MS + 1);
+    assert(a.last_fault.state_before == STARTUP);
+    off(&a);
+
+    /* Hold the values read from the reported B1 photograph. This is an ADC
+     * replay of that observation, not a reconstructed converter waveform. */
+    startup(&a);
+    replay = (Sample){14960, 0, 8, 0, -12, 13828, 1};
+    elapsed = 0;
+    saw_pwm = 0;
+    while (a.state != TRIPPED && elapsed <= STARTUP_NO_RISE_MS + 2) {
+        ticks(&a, &replay, 1, 1, 1);
+        saw_pwm |= a.enable && a.duty > 0;
+        ++elapsed;
+    }
+    assert(saw_pwm && elapsed <= STARTUP_NO_RISE_MS + 1);
+    assert(a.state == TRIPPED && a.fault == F_START_NO_RISE);
+    assert(a.last_fault.valid && a.last_fault.code == F_START_NO_RISE);
+    assert(a.last_fault.state_before == STARTUP);
+    assert(a.last_fault.vin == 14960 && a.last_fault.vin_post == 13828);
+    assert(a.last_fault.vout == 8 && a.last_fault.iout == 0);
+    assert(a.last_fault.il == -12 && a.last_fault.duty > 0);
+    off(&a);
+
+    /* There is a real rise, but neither CV nor CC regulation is reached.
+     * Expiry of the reference ramp cannot by itself authorize RUN. */
+    startup(&a);
+    replay.vout = 700;
+    replay.iout = replay.il = 20;
+    ticks(&a, &replay, STARTUP_RAMP_MS + STARTUP_SETTLE_MS + 50, 1, 1);
+    assert(a.state == STARTUP && a.enable);
+    for (elapsed = 0; elapsed <= STARTUP_TIMEOUT_MS; ++elapsed) {
+        if (a.state == TRIPPED) break;
+        ticks(&a, &replay, 1, 1, 1);
+        assert(a.state != RUN);
+    }
+    assert(a.state == TRIPPED && a.fault == F_START_TIMEOUT);
+    off(&a);
+
+    /* Voltage at target does not establish CV regulation while measured
+     * current exceeds the 200 mA command. This remains below the separate
+     * sampled-current trip, so completion itself must reject the response. */
+    startup(&a);
+    replay = cold;
+    replay.vout = 2000;
+    replay.iout = replay.il = 300;
+    for (elapsed = 0; elapsed <= STARTUP_TIMEOUT_MS; ++elapsed) {
+        if (a.state == TRIPPED) break;
+        ticks(&a, &replay, 1, 1, 1);
+        assert(a.state != RUN);
+    }
+    assert(a.state == TRIPPED && a.fault == F_START_TIMEOUT);
+    off(&a);
+
+    /* Qualification needs 100 consecutive near-target samples after ramp. */
+    startup(&a);
+    replay = cold;
+    replay.vout = 700;
+    replay.iout = replay.il = 20;
+    ticks(&a, &replay, STARTUP_RAMP_MS + 10, 1, 1);
+    assert(a.state == STARTUP);
+    replay.vout = 2000;
+    replay.iout = replay.il = 200;
+    ticks(&a, &replay, STARTUP_SETTLE_MS - 1, 1, 1);
+    assert(a.state == STARTUP);
+    ticks(&a, &replay, 1, 1, 1);
+    assert(a.state == RUN);
+}
+
+static void test_immediate_and_delayed_protection(void)
+{
+    App a;
+    Sample s = cold;
+    ready(&a);
+    request_start(&a);
+    ticks(&a, &s, 1, 0, 1);
+    assert(a.state == TRIPPED && a.fault == F_HARDWARE);
+    off(&a);
+    startup(&a);
+    ticks(&a, &s, 1, 0, 1);
+    assert(a.state == TRIPPED && a.fault == F_HARDWARE);
+    off(&a);
+    running(&a);
+    s = a.last_sample;
+    ticks(&a, &s, 1, 0, 0);
+    assert(a.state == TRIPPED && a.fault == F_HARDWARE);
+    off(&a);
+
+    for (unsigned active = 0; active < 2; ++active) {
+        if (active) running(&a); else startup(&a);
+        s = a.last_sample;
+        ticks(&a, &s, OC_DELAY_MS - 1, 1, 0);
+        assert(a.state == (active ? RUN : STARTUP));
+        ticks(&a, &s, 1, 1, 0);
+        assert(a.state == TRIPPED && a.fault == F_OC);
+        off(&a);
+
+        if (active) running(&a); else startup(&a);
+        s = a.last_sample;
+        ticks(&a, &s, OC_DELAY_MS - 1, 1, 0);
+        ticks(&a, &s, 1, 1, 1);
+        ticks(&a, &s, OC_DELAY_MS - 1, 1, 0);
+        assert(a.state == (active ? RUN : STARTUP));
+        ticks(&a, &s, 1, 1, 0);
+        assert(a.state == TRIPPED && a.fault == F_OC);
+
+        if (active) running(&a); else startup(&a);
+        s = a.last_sample;
+        s.vout = 3000;
+        ticks(&a, &s, 1, 1, 1);
+        assert(a.state == (active ? RUN : STARTUP));
+        s.vout = 3001;
+        ticks(&a, &s, 1, 1, 1);
+        assert(a.state == TRIPPED && a.fault == F_OV);
+        off(&a);
+
+        if (active) running(&a); else startup(&a);
+        s = a.last_sample;
+        s.valid = 0;
+        ticks(&a, &s, 1, 1, 1);
+        assert(a.state == TRIPPED && a.fault == F_ADC);
+        off(&a);
+
+        if (active) running(&a); else startup(&a);
+        s = a.last_sample;
+        s.vin = 16001;
+        ticks(&a, &s, 1, 1, 1);
+        assert(a.state == TRIPPED && a.fault == F_INPUT);
+        off(&a);
+
+        if (active) running(&a); else startup(&a);
+        s = a.last_sample;
+        s.vin_post = 10999;
+        ticks(&a, &s, 1, 1, 1);
+        assert(a.state == TRIPPED && a.fault == F_INPUT);
+        off(&a);
+    }
+
+    running(&a);
+    s = a.last_sample;
+    s.vout = s.iout = s.il = 0;
+    ticks(&a, &s, UV_DELAY_MS - 1, 1, 1);
+    assert(a.state == RUN);
+    ticks(&a, &s, 1, 1, 1);
+    assert(a.state == TRIPPED && a.fault == F_LOW_OUTPUT);
+    off(&a);
+
+    startup(&a);
+    s = cold;
+    s.iout = SAMPLED_IOUT_TRIP_MA + 1;
+    ticks(&a, &s, SAMPLED_CURRENT_DELAY_MS - 1, 1, 1);
+    assert(a.state == STARTUP);
+    ticks(&a, &s, 1, 1, 1);
+    assert(a.state == TRIPPED && a.fault == F_CURRENT);
+    off(&a);
+    running(&a);
+    s = a.last_sample;
+    s.il = SAMPLED_IL_TRIP_MA + 1;
+    ticks(&a, &s, SAMPLED_CURRENT_DELAY_MS, 1, 1);
+    assert(a.state == TRIPPED && a.fault == F_CURRENT);
+    off(&a);
+    running(&a);
+    s = a.last_sample;
+    s.il = -SAMPLED_IL_TRIP_MA - 1;
+    ticks(&a, &s, SAMPLED_CURRENT_DELAY_MS, 1, 1);
+    assert(a.state == TRIPPED && a.fault == F_CURRENT);
+    off(&a);
+}
+
+static void test_implausible_samples_do_not_reach_control_math(void)
+{
+    const i32 extremes[] = {INT_MIN, INT_MAX};
+    for (unsigned active = 0; active < 2; ++active) {
+        for (unsigned channel = 0; channel < 6; ++channel) {
+            for (unsigned value = 0; value < 2; ++value) {
+                App a;
+                if (active) running(&a); else startup(&a);
+                Sample s = a.last_sample;
+                switch (channel) {
+                case 0: s.vin = extremes[value]; break;
+                case 1: s.iin = extremes[value]; break;
+                case 2: s.vout = extremes[value]; break;
+                case 3: s.iout = extremes[value]; break;
+                case 4: s.il = extremes[value]; break;
+                default: s.vin_post = extremes[value]; break;
+                }
+                ticks(&a, &s, 1, 1, 1);
+                assert(a.state == TRIPPED && a.fault == F_ADC);
+                off(&a);
+            }
+        }
+    }
+}
+
+static void test_first_fault_and_manual_restart(void)
+{
+    App a;
+    running(&a);
+    Sample s = a.last_sample;
+    i32 duty_before = a.duty;
+    assert(duty_before > 0);
+    s.vout = 3001;
+    s.iout = 173;
+    s.il = 185;
+    ticks(&a, &s, 1, 1, 1);
+    assert(a.state == TRIPPED && a.fault == F_OV);
+    assert(a.last_fault.valid && a.last_fault.code == F_OV);
+    assert(a.last_fault.state_before == RUN);
+    assert(a.last_fault.vout == 3001 && a.last_fault.iout == 173);
+    assert(a.last_fault.il == 185 && a.last_fault.vin == s.vin);
+    assert(a.last_fault.vin_post == s.vin_post);
+    assert(a.last_fault.duty == duty_before);
+    assert(a.last_fault.flags & RECORD_ENABLE);
+    assert(!(a.last_fault.flags & RECORD_ARM));
+    assert(a.last_fault.flags & RECORD_SAMPLE_VALID);
+    assert(a.last_fault.flags & RECORD_BYPASS);
+    FaultRecord first = a.last_fault;
+    off(&a);
+
+    s.valid = 0;
+    ticks(&a, &s, 1000, 0, 0);
+    app_trip(&a, F_TIMING);
+    assert(a.state == TRIPPED && a.fault == F_OV);
+    record_equal(&first, &a.last_fault);
+    assert(app_command(&a, CMD_START, 0) == CMD_BAD_STATE);
+    assert(app_command(&a, CMD_CONFIRM_BYPASS, 0) == CMD_BAD_STATE);
+    record_equal(&first, &a.last_fault);
+
+    assert(app_command(&a, CMD_STOP, 0) == CMD_OK);
+    assert(a.state == OFF && !a.bypass_confirmed);
+    record_equal(&first, &a.last_fault);
+    ticks(&a, &cold, 1000, 1, 1);
+    assert(a.state == OFF);
+    record_equal(&first, &a.last_fault);
+    off(&a);
+    assert(app_command(&a, CMD_PRECHARGE, 0) == CMD_OK);
+    assert(!a.last_fault.valid && a.fault == F_NONE);
+    ticks(&a, &cold, PRECHARGE_MS, 1, 1);
+    assert(a.state == READY && !a.bypass_confirmed);
+    assert(app_command(&a, CMD_START, 0) == CMD_BAD_STATE);
+    off(&a);
+
+    running(&a);
+    app_trip(&a, F_TIMING);
+    assert(a.state == TRIPPED && a.last_fault.valid);
+    assert(app_command(&a, CMD_CLEAR_RECORD, 0) == CMD_OK);
+    assert(!a.last_fault.valid);
+    assert(a.state == TRIPPED && a.fault == F_TIMING);
+    assert(app_command(&a, CMD_START, 0) == CMD_BAD_STATE);
+    off(&a);
+}
+
+static void test_stop_from_every_state(void)
+{
+    for (unsigned state = OFF; state <= TRIPPED; ++state) {
+        App a;
+        if (state == OFF) app_init(&a);
+        else if (state == PRECHARGE) {
+            app_init(&a);
+            assert(app_command(&a, CMD_PRECHARGE, 0) == CMD_OK);
+        } else if (state == READY) ready(&a);
+        else if (state == ARMING) { ready(&a); request_start(&a); }
+        else if (state == STARTUP) startup(&a);
+        else {
+            running(&a);
+            if (state == TRIPPED) app_trip(&a, F_TIMING);
+        }
+        assert(a.state == (State)state);
+        FaultRecord saved = a.last_fault;
+        assert(app_command(&a, CMD_STOP, 0) == CMD_OK);
+        assert(a.state == OFF && !a.bypass_confirmed);
+        assert(a.vset == 2000 && a.iset == 200);
+        record_equal(&saved, &a.last_fault);
+        off(&a);
+        ticks(&a, &cold, STARTUP_TIMEOUT_MS + 1, 1, 1);
+        assert(a.state == OFF);
+        off(&a);
+    }
+}
+
+static void test_adc_units(void)
+{
+    const u16 raw[6] = {1692, 124, 226, 248, 2048, 1636};
+    u16 bad[6] = {1692, 124, 226, 248, 2048, 1636};
+    Sample s;
+    adc_convert(raw, &s);
+    assert(s.valid);
+    assert(s.vin >= 14990 && s.vin <= 15010);
+    assert(s.iin >= 98 && s.iin <= 101);
+    assert(s.vout >= 1995 && s.vout <= 2010);
+    assert(s.iout >= 198 && s.iout <= 202);
+    assert(s.il >= -2 && s.il <= 2);
+    assert(s.vin_post >= 14490 && s.vin_post <= 14510);
+    bad[0] = 4095;
+    adc_convert(bad, &s);
+    assert(!s.valid);
+    bad[0] = raw[0];
+    bad[4] = 0;
+    adc_convert(bad, &s);
+    assert(!s.valid);
+}
+
+typedef struct { double il, vout; } Plant;
+
+/* Approximate averaged synchronous buck: no switching ripple, dead time,
+ * diode/body-diode paths, ADC noise/delay, saturation, or hardware protection.
+ * RK4 at 1 us avoids disguising the 220 uH/470 uF resonance with a coarse
+ * 1 ms Euler step. The production controller still executes only at 1 kHz. */
+static Plant derivative(Plant p, double duty, double load)
+{
+    Plant d = {(duty * 13.8 - p.vout - .15 * p.il) / 220e-6,
+               (p.il - p.vout / load) / 470e-6};
+    return d;
+}
+
+static Plant plus(Plant p, Plant k, double step)
+{
+    Plant q = {p.il + step * k.il, p.vout + step * k.vout};
+    return q;
+}
+
+static void integrate(Plant *p, double duty, double load)
+{
+    const double dt = 1e-6;
+    for (unsigned us = 0; us < 1000; ++us) {
+        Plant k1 = derivative(*p, duty, load);
+        Plant k2 = derivative(plus(*p, k1, dt / 2), duty, load);
+        Plant k3 = derivative(plus(*p, k2, dt / 2), duty, load);
+        Plant k4 = derivative(plus(*p, k3, dt), duty, load);
+        p->il += dt / 6 * (k1.il + 2 * k2.il + 2 * k3.il + k4.il);
+        p->vout += dt / 6 * (k1.vout + 2 * k2.vout + 2 * k3.vout + k4.vout);
+        assert(isfinite(p->il) && isfinite(p->vout));
+    }
+}
+
+static void plant_run(double load)
+{
+    App a;
+    Plant p = {0, 0};
+    Sample s = cold;
+    double peak = 0, v_sum = 0, i_sum = 0;
+    double v_min = 100, v_max = -100;
+    unsigned first_run = 0, count = 0;
+    int saw_pwm_before_run = 0;
+    ready(&a);
+    request_start(&a);
+    for (unsigned ms = 1; ms <= 1600; ++ms) {
+        s.vout = (i32)lround(1000 * p.vout);
+        s.iout = (i32)lround(1000 * p.vout / load);
+        s.il = (i32)lround(1000 * p.il);
+        s.iin = (i32)lround(1000 * p.il * a.duty / 10000.0);
+        ticks(&a, &s, 1, 1, 1);
+        if (a.state == TRIPPED) {
+            fprintf(stderr, "LC R=%.1f tripped at %u ms: fault=%d V=%.4f I=%.4f IL=%.4f duty=%d\n",
+                    load, ms, a.fault, p.vout, p.vout / load, p.il,
+                    a.last_fault.duty);
+        }
+        assert(a.state == ARMING || a.state == STARTUP || a.state == RUN);
+        if (a.state == STARTUP && a.duty > 0) saw_pwm_before_run = 1;
+        if (a.state == RUN && !first_run) first_run = ms;
+        integrate(&p, a.enable ? a.duty / 10000.0 : 0, load);
+        if (p.vout > peak) peak = p.vout;
+        assert(p.vout <= 3.0);
+        if (ms > 1400) {
+            v_sum += p.vout;
+            i_sum += p.vout / load;
+            if (p.vout < v_min) v_min = p.vout;
+            if (p.vout > v_max) v_max = p.vout;
+            ++count;
+        }
+    }
+    assert(saw_pwm_before_run && first_run && first_run <= 1005);
+    assert(a.state == RUN);
+    double mean_v = v_sum / count, mean_i = i_sum / count;
+    double expected_v = load < 10 ? .2 * load : 2.0;
+    printf("LC approximate R=%.1f: RUN=%ums mean=%.4fV/%.4fA peak=%.4fV ripple=%.4fV\n",
+           load, first_run, mean_v, mean_i, peak, v_max - v_min);
+    fflush(stdout);
+    assert(fabs(mean_v - expected_v) <= expected_v * .15);
+    assert(fabs(mean_i - .2) <= .2 * .15);
+    assert(v_max - v_min <= .10);
+    assert(app_command(&a, CMD_STOP, 0) == CMD_OK);
+    off(&a);
+}
+
+int main(void)
+{
+    test_commands_and_interlocks();
+    test_arm_timing_and_start_edit_lock();
+    test_input_and_prebias_boundaries();
+    test_current_before_arm_or_enable();
+    test_no_feedback_and_response_gating();
+    test_immediate_and_delayed_protection();
+    test_implausible_samples_do_not_reach_control_math();
+    test_first_fault_and_manual_restart();
+    test_stop_from_every_state();
+    test_adc_units();
+    plant_run(10);
+    plant_run(8);
+    plant_run(5);
+    puts("PASS B2: real controller interlocks, startup/response, protections, first-fault retention, STOP, ADC and approximate LC regressions");
+    return 0;
+}
