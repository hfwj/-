+#ifndef APP_H
+#define APP_H
+#include "config.h"
+
+typedef unsigned int u32;
+typedef unsigned short u16;
+typedef unsigned char u8;
+typedef signed int i32;
+
+typedef enum {
+ OFF=0, PRECHARGE=1, READY=2, ARMING=3, STARTUP=4, RUN=5, TRIPPED=6
+} State;
+#define SOFTSTART STARTUP
+typedef enum {
+ F_NONE=0, F_HARDWARE=1, F_ADC=2, F_INPUT=3, F_OC=4,
+ F_LOW_OUTPUT=5, F_OV=6, F_TIMING=7, F_START_NO_RISE=8,
+ F_START_TIMEOUT=9, F_CURRENT=10, F_PREBIAS=11, F_ARM_PIN=12, F_EN_PIN=13
+} Fault;
+typedef enum {
+ CMD_NONE=0, CMD_PRECHARGE=1, CMD_CONFIRM_BYPASS=2, CMD_START=3,
+ CMD_STOP=4, CMD_SET_V=5, CMD_SET_I=6, CMD_CLEAR_RECORD=7
+} Command;
+typedef enum {
+ CMD_OK=0, CMD_BAD_STATE=1, CMD_BAD_VALUE=2, CMD_LOCKED=3, CMD_UNKNOWN=4
+} CmdResult;
+typedef struct {
+ i32 vin, iin, vout, iout, il, vin_post; /* mV and mA */
+ u8 valid;
+} Sample;
+
+#define RECORD_SAMPLE_VALID (1u<<0)
+#define RECORD_FAULT_N      (1u<<1)
+#define RECORD_OC_N         (1u<<2)
+#define RECORD_ENABLE       (1u<<3)
+#define RECORD_ARM          (1u<<4)
+#define RECORD_CC_MODE      (1u<<5)
+#define RECORD_BYPASS       (1u<<6)
+#define RECORD_OUTPUT_ROSE  (1u<<7)
+typedef struct {
+ u32 valid, code, state_before, tick_ms, startup_ms;
+ i32 vout, iout, il, vin, vin_post, duty, cv_out, cc_out;
+ u32 flags;
+ u32 state_ms;
+ i32 target_mv, max_vout;
+} FaultRecord;
+
+typedef struct {
+ State state;
+ Fault fault;
+ i32 vset, iset, duty;
+ u8 enable, arm, bypass_confirmed, cc_mode, edit_current;
+ u32 tick_ms, state_ms, startup_ms;
+ i32 target_mv, max_vout, cv_out, cc_out;
+ FaultRecord last_fault;
+ /* Private controller state is exposed for deterministic SWD diagnostics. */
+ Sample last_sample;
+ u32 oc_ms, uv_ms, pre_ms, stable_ms, current_ms;
+ i32 cv_integral, cc_integral;
+ u8 fault_n, oc_n, sample_seen, output_rose;
+} App;
+
+void app_init(App *a);
+CmdResult app_command(App *a, Command c, i32 value);
+void app_tick(App *a, const Sample *s, u8 fault_n, u8 oc_n);
+void app_trip(App *a, Fault f);
+void adc_convert(const u16 raw[6], Sample *s);
+extern i32 adc_offset[6], adc_gain_ppm[6];
+#endif
