+	gcc -std=c11 -Wall -Wextra -Werror -Iinclude src/app.c tests/test_locked.c -o build/tests/locked
+	./build/tests/locked
+	gcc -std=c11 -Wall -Wextra -Werror -Iinclude tests/test_adc_registers.c src/measurement.c -o build/tests/adc_registers
+	./build/tests/adc_registers
+	gcc -std=c11 -Wall -Wextra -Werror -Iinclude src/app.c src/measurement.c src/diag.c tests/test_diag.c -o build/tests/diag
+	./build/tests/diag
+	gcc -std=c11 -Wall -Wextra -Werror -Iinclude -DPOWER_STAGE_ALLOWED=1 src/app.c src/measurement.c src/diag.c tests/test_platform.c -o build/tests/platform
+	./build/tests/platform
+clean:
+	rm -rf build
