* Original TI sensing model interface check
.include "../INA181A1_TI_6PIN.lib"
V_SUP VA 0 3.3
V_CM CM 0 10
X_W OW 0 IP CM 0 VA INA181A1_TI_6PIN
X_D IP CM VA 0 0 OD INA181A1
R_W OW 0 100k
R_D OD 0 100k
.options method=gear maxord=2 reltol=1e-4 abstol=1e-10 vntol=1e-6
V_DIFF IP CM 0
.dc V_DIFF -0.02 0.06 0.002
.end
