.SUBCKT GBUCK_CTRL_EQ PWM COM VO CAP VIN ILP
* Functional soft-start and cascaded CV/current control, not firmware.
* Forced-continuous synchronous operation permits -0.15A transient inductor reference at light load.
V_SS REF COM PWL(0 0 2m 0 12m 10 60m 10)
E_IL ILRAW COM VALUE={V(ILP,CAP)/0.025}
R_IL ILRAW ILF 1k
C_IL ILF COM 10n IC=0
E_VPI UV COM VALUE={0.4*(V(REF,COM)-V(VO,COM))+V(IV,COM)}
E_IREF IREF COM VALUE={LIMIT(V(UV,COM),-0.15,1)}
G_IV COM IV VALUE={100*(V(REF,COM)-V(VO,COM))+1000*(V(IREF,COM)-V(UV,COM))}
C_IV IV COM 1 IC=0
R_IV IV COM 1G
E_IPI UD COM VALUE={V(VO,COM)/MAX(V(VIN,COM),10)+0.04*(V(IREF,COM)-V(ILF,COM))+V(II,COM)}
E_D DUTY COM VALUE={LIMIT(V(UD,COM),0,0.9)}
G_II COM II VALUE={50*(V(IREF,COM)-V(ILF,COM))+1000*(V(DUTY,COM)-V(UD,COM))}
C_II II COM 1 IC=0
R_II II COM 1G
V_SAW SAW COM PULSE(0 1 0 9.98u 20n 0 10u)
E_PWM PWM COM VALUE={IF(TIME<2m,0,LIMIT(1650*(V(DUTY,COM)-V(SAW,COM))+1.65,0,3.3))}
.ENDS GBUCK_CTRL_EQ
